@model List<(int Id, string Title, string Slug, string Category, bool IsFeatured, bool IsPublished, DateTime PublishedAt)>
@{
    ViewData["Title"] = "Bài viết";
}

<div class="admin-toolbar">
    <div class="spacer"></div>
    <a class="admin-btn admin-btn--primary" href="/admin/blog/them">+ Thêm bài viết</a>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead><tr><th>Tiêu đề</th><th>Chuyên mục</th><th>Ngày đăng</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" style="color:var(--color-grey-500);text-align:center;padding:32px;">Chưa có bài viết nào.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        <a class="admin-row-link" href="/admin/blog/@p.Id/sua">@p.Title</a>
                        @if (p.IsFeatured)
                        {
                            <span class="admin-badge admin-badge--amber" style="margin-left:8px;">Nổi bật</span>
                        }
                    </td>
                    <td style="color:var(--color-grey-500);">@p.Category</td>
                    <td style="color:var(--color-grey-500);">@p.PublishedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (p.IsPublished)
                        {
                            <span class="admin-badge admin-badge--green">Đang đăng</span>
                        }
                        else
                        {
                            <span class="admin-badge admin-badge--grey">Nháp</span>
                        }
                    </td>
                    <td class="num">
                        <form method="post" action="/admin/blog/@p.Id/an-hien" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">@(p.IsPublished ? "Ẩn" : "Đăng")</button>
                        </form>
                        <form method="post" action="/admin/blog/@p.Id/xoa" data-confirm="Xóa bài viết &quot;@p.Title&quot;?" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
