@model List<Hoaii.Domain.Entities.AdminAuditLog>
@{
    ViewData["Title"] = "Nhật ký";
    int page = ViewBag.Page; int totalPages = ViewBag.TotalPages;
    string BuildUrl(int p) => "/admin/nhat-ky?page=" + p;
}

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Hành động</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="admin-table__empty">Chưa có hoạt động nào.</td></tr>
            }
            @foreach (var l in Model)
            {
                <tr>
                    <td style="white-space:nowrap;">@l.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(l.AdminUser?.FullName ?? "—")</td>
                    <td>@l.Action</td>
                    <td>@l.EntityType@(l.EntityId is not null ? $" #{l.EntityId}" : "")</td>
                    <td style="color:var(--color-grey-600);">@l.Detail</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="@((page, totalPages, (Func<int,string>)BuildUrl))" />
