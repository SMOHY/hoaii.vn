@model List<Hoaii.Domain.Entities.ContactSubmission>
@{
    ViewData["Title"] = "Hộp thư — Liên hệ";
}

<partial name="_InboxTabs" />

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead><tr><th>Ngày</th><th>Người gửi</th><th>Liên hệ</th><th>Nội dung</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" style="color:var(--color-grey-500);text-align:center;padding:32px;">Chưa có liên hệ nào.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr style="@(c.IsHandled ? "opacity:.6;" : "")">
                    <td style="white-space:nowrap;color:var(--color-grey-500);">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                    <td>@c.FullName</td>
                    <td><a class="admin-row-link" href="mailto:@c.Email">@c.Email</a>@(string.IsNullOrEmpty(c.Phone) ? "" : $" · {c.Phone}")</td>
                    <td style="max-width:360px;">@c.Message</td>
                    <td>@(c.IsHandled ? Html.Raw("<span class=\"admin-badge admin-badge--green\">Đã xử lý</span>") : Html.Raw("<span class=\"admin-badge admin-badge--amber\">Mới</span>"))</td>
                    <td class="num" style="white-space:nowrap;">
                        <form method="post" action="/admin/hop-thu/lien-he/@c.Id/xu-ly" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">@(c.IsHandled ? "Bỏ" : "Xong")</button>
                        </form>
                        <form method="post" action="/admin/hop-thu/lien-he/@c.Id/xoa" data-confirm="Xóa liên hệ này?" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
