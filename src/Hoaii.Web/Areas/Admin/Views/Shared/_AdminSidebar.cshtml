@using System.Security.Claims
@{
    var current = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var isOwner = User.FindFirstValue(Hoaii.Web.Services.Admin.AdminAuth.RoleClaim) == nameof(AdminRole.Owner);
    var pendingOrders = ViewBag.PendingOrderCount as int?;

    string Active(params string[] controllers) =>
        controllers.Contains(current, StringComparer.OrdinalIgnoreCase) ? "is-active" : "";
}
<nav class="admin-nav">
    <a class="admin-nav__link @Active("Dashboard")" href="/admin">
        <svg viewBox="0 0 24 24" fill="none"><path d="M3 12l9-9 9 9M5 10v10h5v-6h4v6h5V10" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Tổng quan
    </a>

    <div class="admin-nav__group-label">Bán hàng</div>
    <a class="admin-nav__link @Active("Orders")" href="/admin/don-hang">
        <svg viewBox="0 0 24 24" fill="none"><path d="M6 2l1.5 3h9L18 2M4 7h16l-1.5 13H5.5L4 7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Đơn hàng
        @if (pendingOrders is > 0)
        {
            <span class="admin-nav__badge">@pendingOrders</span>
        }
    </a>
    <a class="admin-nav__link @Active("Products")" href="/admin/san-pham">
        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l9 5v10l-9 5-9-5V7l9-5zM3 7l9 5 9-5M12 12v10" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Sản phẩm
    </a>
    <a class="admin-nav__link @Active("Categories")" href="/admin/danh-muc">
        <svg viewBox="0 0 24 24" fill="none"><path d="M3 5h18M3 12h18M3 19h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Danh mục
    </a>
    <a class="admin-nav__link @Active("Customers")" href="/admin/khach-hang">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6" stroke="currentColor" stroke-width="1.6"/></svg>
        Khách hàng
    </a>

    <div class="admin-nav__group-label">Nội dung</div>
    <a class="admin-nav__link @Active("Homepage")" href="/admin/trang-chu">
        <svg viewBox="0 0 24 24" fill="none"><path d="M3 11l9-8 9 8M5 9v11h5v-6h4v6h5V9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Trang chủ
    </a>
    <a class="admin-nav__link @Active("Blog")" href="/admin/blog">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 4h16v13H7l-3 3V4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Bài viết
    </a>
    <a class="admin-nav__link @Active("Policies")" href="/admin/chinh-sach">
        <svg viewBox="0 0 24 24" fill="none"><path d="M6 3h9l4 4v14H6V3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12h6M9 16h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Chính sách
    </a>
    <a class="admin-nav__link @Active("Menu")" href="/admin/menu">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Menu điều hướng
    </a>
    <a class="admin-nav__link @Active("Media")" href="/admin/thu-vien-anh">
        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><circle cx="8.5" cy="10" r="1.5" fill="currentColor"/><path d="M21 16l-5-5-8 8" stroke="currentColor" stroke-width="1.6"/></svg>
        Thư viện ảnh
    </a>
    <a class="admin-nav__link @Active("Settings")" href="/admin/cai-dat">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Cài đặt chung
    </a>

    @if (isOwner)
    {
        <div class="admin-nav__group-label">Hệ thống</div>
        <a class="admin-nav__link @Active("AdminUsers")" href="/admin/tai-khoan">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c0-3.5 3-5.5 7-5.5s7 2 7 5.5" stroke="currentColor" stroke-width="1.6"/><path d="M18 3l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2z" fill="currentColor"/></svg>
            Tài khoản admin
        </a>
        <a class="admin-nav__link @Active("AuditLog")" href="/admin/nhat-ky">
            <svg viewBox="0 0 24 24" fill="none"><path d="M5 3h11l3 3v15H5V3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 9h8M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            Nhật ký
        </a>
    }
</nav>
