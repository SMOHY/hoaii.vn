@model IReadOnlyDictionary<string, string>
@{
    ViewData["Title"] ??= "Cài đặt";
    var fields = ViewBag.Fields as IReadOnlyList<(string Key, string Label, string Default, bool Multiline, string Group)>;
    var action = ViewBag.FormAction as string ?? "/admin/cai-dat";
    var intro = ViewBag.Intro as string;
}

<div class="admin-card">
    @if (!string.IsNullOrEmpty(intro))
    {
        <p style="color:var(--color-grey-500);margin:0 0 20px;">@intro</p>
    }
    <form method="post" action="@action" class="admin-form">
        @Html.AntiForgeryToken()
        @foreach (var f in fields!)
        {
            <div class="admin-field">
                <label>@f.Label</label>
                @if (f.Multiline)
                {
                    <textarea name="settings_[@f.Key]" rows="3">@Model[f.Key]</textarea>
                }
                else
                {
                    <input type="text" name="settings_[@f.Key]" value="@Model[f.Key]" />
                }
            </div>
        }
        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn--primary">Lưu</button>
        </div>
    </form>
</div>
