@using Hoaii.Web.Areas.Admin.Models
@model Hoaii.Domain.Entities.Collection
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm bộ sưu tập" : "Sửa bộ sưu tập";
    var heroSlides = ViewBag.HeroSlides as List<Hoaii.Domain.Entities.CollectionHeroSlide> ?? [];
}

@functions {
    string Thumb(string? url) => string.IsNullOrEmpty(url)
        ? "background:var(--color-grey-50);"
        : $"background:var(--color-grey-50) center/cover no-repeat url('{url}');";
}

<div style="margin-bottom:20px;"><a class="admin-row-link" href="/admin/bo-suu-tap">← Bộ sưu tập</a></div>

<div class="admin-card">
    <form method="post" action="/admin/bo-suu-tap/luu" class="admin-form admin-form--wide">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="admin-field">
            <label>Tên bộ sưu tập</label>
            <input type="text" name="name" value="@Model.Name" required autofocus />
        </div>
        <div class="admin-field">
            <label>Slug</label>
            <input type="text" name="slug" value="@Model.Slug" placeholder="Để trống sẽ tự sinh từ tên" />
            <span class="admin-field__hint">Địa chỉ trang: /bo-suu-tap/&lt;slug&gt;</span>
        </div>
        <div class="admin-field">
            <label>Thứ tự hiển thị</label>
            <input type="number" name="sortOrder" value="@Model.SortOrder" />
        </div>

        <hr style="border:none;border-top:1px solid var(--color-grey-200);margin:24px 0;" />
        <h3 style="font-family:var(--font-display);font-size:18px;margin:0 0 4px;">Nội dung trang bộ sưu tập</h3>
        <p class="admin-field__hint" style="margin:0 0 16px;">Để trống sẽ dùng nội dung mặc định.</p>

        <div class="admin-field">
            <label>Mô tả (dưới tiêu đề)</label>
            @* Xem ghi chú ở Categories/Edit: mô tả giữ được xuống dòng nên phải là ô nhiều dòng. *@
            <textarea name="cms.Description" rows="3">@Model.Description</textarea>
        </div>
        <div class="admin-form-row">
            <div class="admin-field">
                <label>Eyebrow hero</label>
                <input type="text" name="cms.HeroEyebrow" value="@Model.HeroEyebrow" placeholder="VD: Thiên Điểu Lạc Hồng đặc sắc" />
            </div>
            <div class="admin-field">
                <label>Dòng dưới ảnh hero</label>
                <input type="text" name="cms.HeroKicker" value="@Model.HeroKicker" placeholder="VD: Bộ quà 6 hộp" />
                <span class="admin-field__hint">Để trống thì ẩn dòng này.</span>
            </div>
        </div>

        <h4 style="margin:16px 0 8px;font:600 14px var(--font-body);">Banner khuyến mãi</h4>
        <div class="admin-form-row">
            <div class="admin-field">
                <label>Eyebrow banner</label>
                <input type="text" name="cms.PromoEyebrow" value="@Model.PromoEyebrow" />
            </div>
            <div class="admin-field">
                <label>Nút — chữ</label>
                <input type="text" name="cms.PromoCtaText" value="@Model.PromoCtaText" placeholder="Mua ngay" />
            </div>
        </div>
        <div class="admin-field">
            <label>Tiêu đề banner</label>
            <textarea name="cms.PromoTitle" rows="2">@Model.PromoTitle</textarea>
        </div>
        <div class="admin-field">
            <label>Nút — liên kết</label>
            <input type="text" name="cms.PromoCtaUrl" value="@Model.PromoCtaUrl" placeholder="/bo-suu-tap/@Model.Slug" />
        </div>
        <partial name="_ImageField" model="@(new ImageFieldModel("Ảnh banner khuyến mãi", "cms.PromoImageUrl", "col-promo-img", Model.PromoImageUrl) { MobileName = "cms.PromoImageUrlMobile", MobileId = "col-promo-img-mb", MobileValue = Model.PromoImageUrlMobile, FocalName = "cms.PromoImageFocal", FocalId = "col-promo-img-fc", FocalValue = Model.PromoImageFocal })" />

        <div class="admin-form-row">
            <div class="admin-field">
                <label>Màu nền banner</label>
                <input type="text" name="cms.PromoBackground" value="@Model.PromoBackground"
                       placeholder="#E5D9CB" pattern="^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" />
                <span class="admin-field__hint">Chỉ nhận mã hex, VD <code>#AA8656</code>. Để trống dùng màu mặc định.</span>
            </div>
            <div class="admin-field">
                <label>Bố cục banner</label>
                <select name="cms.PromoWide">
                    <option value="false" selected="@(!Model.PromoWide)">Hẹp — chữ 760, ảnh 760</option>
                    <option value="true" selected="@Model.PromoWide">Rộng — ảnh 840</option>
                </select>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn--primary">Lưu</button>
            <a class="admin-btn admin-btn--secondary" href="/admin/bo-suu-tap">Hủy</a>
        </div>
    </form>
</div>

@if (!isNew)
{
    @* Nếu bộ sưu tập chưa có dòng nào ở đây, trang bộ sưu tập vẫn tự lấy ảnh từ 6 sản phẩm đầu
       tiên (xem CollectionController.Index) — thêm 1 slide bên dưới là đủ để chuyển sang danh
       sách tự quản lý này. *@
    <div class="admin-card" style="margin-top:24px;">
        <div class="admin-toolbar" style="margin-bottom:16px;">
            <h2 style="font-family:var(--font-display);margin:0;font-size:20px;">Slide hero</h2>
            <div class="spacer"></div>
            <a class="admin-btn admin-btn--primary admin-btn--sm" href="/admin/bo-suu-tap/@Model.Id/slide/them">+ Thêm</a>
        </div>
        <p class="admin-field__hint" style="margin:0 0 16px;">
            Chưa thêm slide nào thì ảnh carousel đầu trang tự lấy từ 6 sản phẩm đầu của bộ sưu tập này.
            Thêm 1 slide bên dưới sẽ chuyển hẳn sang danh sách bạn tự quản lý.
        </p>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th></th><th>Tên</th><th class="num">Thứ tự</th><th>Hiện</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in heroSlides)
                    {
                        <tr>
                            <td><div style="width:64px;height:40px;border-radius:4px;@Thumb(s.ImageUrl)"></div></td>
                            <td><a class="admin-row-link" href="/admin/bo-suu-tap/slide/@s.Id/sua">@s.Name</a></td>
                            <td class="num">@s.SortOrder</td>
                            <td>@(s.IsActive ? "✓" : "—")</td>
                            <td class="num">
                                <form method="post" action="/admin/bo-suu-tap/slide/@s.Id/xoa" data-confirm="Xóa slide này?" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (heroSlides.Count == 0)
                    {
                        <tr><td colspan="5" style="color:var(--color-grey-500);">Chưa có slide nào — đang dùng ảnh sản phẩm tự động.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<partial name="_PickerModal" />

@section Scripts {
    <script src="~/js/admin-imagefield.js" asp-append-version="true"></script>
}
