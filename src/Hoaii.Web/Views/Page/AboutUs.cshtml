@using Hoaii.Web.Services
@inject PageContentService Page
@{
    ViewData["Title"] = "Về chúng tôi";
    ViewData["MetaDescription"] = "Câu chuyện thương hiệu HOÀI — hành trình gìn giữ và lan tỏa tinh thần văn hóa Việt qua từng món quà.";
    string T(string k) => Page.Get(PageContentKeys.About, k);
    var customerLogos = ViewBag.CustomerLogos as IReadOnlyList<string> ?? new List<string>();
}

@* Section tabs (node 778:24899). Anchor links into the sections below. *@
<nav class="about-tabs">
    <div class="about-tabs__inner">
        <a class="about-tabs__link is-active" href="#khoi-dau">Khởi đầu</a>
        <a class="about-tabs__link" href="#nen-tang">Nền tảng</a>
        <a class="about-tabs__link" href="#doi-ngu">Đội ngũ</a>
        <a class="about-tabs__link" href="#khach-hang">Khách hàng</a>
    </div>
</nav>

<section class="about-page-hero" id="khoi-dau">
    @* The headline is a two-sentence manifesto over 200 characters long. It reads as the page's
       title visually, but as an h1 it is unusable — a screen reader announces the whole paragraph
       as the page name, and search engines get no usable title. So the real h1 is a short hidden
       one and the manifesto stays a paragraph at exactly the same size.
       Figma runs different copy per breakpoint: desktop 955:18592, mobile 1068:33689. *@
    <h1 class="visually-hidden">Về HOÀI</h1>
    <p class="about-page-hero__headline">
        <span class="u-desktop-only">@T("hero_headline_desktop")</span>
        <span class="u-mobile-only">@T("hero_headline_mobile")</span>
    </p>

    <div class="about-page-hero__media">
        <div class="about-page-hero__img">
            <img src="@T("hero_image")" alt="Đội ngũ HOÀI" loading="lazy" />
        </div>
        <div class="about-page-hero__caption">
            <p class="about-page-hero__caption-label">@T("caption_label")</p>
            <p class="about-page-hero__caption-text">@T("caption_1")</p>
            <p class="about-page-hero__caption-text">@T("caption_2")</p>
        </div>
    </div>

    <blockquote class="about-page-hero__quote">“@T("quote")”</blockquote>

    <div class="about-page-hero__story">
        <p class="about-page-hero__story-text">@ContentText.Lines(T("story"))</p>
        <div class="about-page-hero__story-img">
            <img src="@T("story_image")" alt="Sản phẩm HOÀI" loading="lazy" />
        </div>
    </div>
</section>

<section class="about-foundation" id="nen-tang">
    <h2 class="about-foundation__heading">@T("foundation_heading")</h2>
    <div class="about-foundation__grid">
        @for (var i = 1; i <= 3; i++)
        {
            <div class="about-foundation__item">
                <span class="about-foundation__number">@i.ToString("D2")</span>
                <div class="about-foundation__body">
                    <h3>@T($"found_{i}_title")</h3>
                    <p>@ContentText.Lines(T($"found_{i}_body"))</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="about-team" id="doi-ngu">
    <div class="about-team__intro">
        <h2 class="about-team__heading">@T("team_heading")</h2>
        <p class="about-team__subtitle">@T("team_subtitle")</p>
    </div>
    @* Collage: one tall tile on the right, one wide tile above two small ones (node 792:24972). *@
    <div class="about-team__collage">
        <div class="about-team__tile about-team__tile--wide"><img src="@T("team_img_wide")" alt="Đội ngũ HOÀI" loading="lazy" /></div>
        <div class="about-team__smalls">
            <div class="about-team__tile"><img src="@T("team_img_small_1")" alt="Đội ngũ HOÀI" loading="lazy" /></div>
            <div class="about-team__tile"><img src="@T("team_img_small_2")" alt="Đội ngũ HOÀI" loading="lazy" /></div>
        </div>
        <div class="about-team__tile about-team__tile--main"><img src="@T("team_img_main")" alt="Đội ngũ HOÀI" loading="lazy" /></div>
    </div>
</section>

<div id="khach-hang">
    @await Html.PartialAsync("~/Views/Home/Sections/_Customers.cshtml", customerLogos.ToList())
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}
