@model Hoaii.Web.Models.Page.WholesaleFormModel
@using Hoaii.Web.Services
@inject PageContentService Page
@{
    ViewData["Title"] = "Hợp tác";
    string T(string k) => Page.Get(PageContentKeys.Partners, k);
    var partnerLogos = ViewBag.PartnerLogos as IReadOnlyList<string> ?? new List<string>();
}

@* Figma's desktop frame still reads "Mua quà tết" here while its mobile frame reads
   "Hợp tác" (node 1068:39192). Going with the page's own name. *@
<nav class="partners-breadcrumb">
    <a href="/">Trang chủ</a><span>/</span><span class="partners-breadcrumb__current">Hợp tác</span>
</nav>

@* The design opens on the statistics band with no page title, so the h1 the page needs for
   structure is hidden rather than added to the layout. *@
<h1 class="visually-hidden">Hợp tác cùng HOÀI</h1>

<section class="partners-pride">
    <div class="partners-stats">
        <p class="partners-stats__heading">@T("stats_heading")</p>
        <div class="partners-stats__grid">
            @for (var i = 1; i <= 3; i++)
            {
                <div class="partners-stats__item">
                    <span class="partners-stats__number">@T($"stat_{i}_number")</span>
                    <span class="partners-stats__label">@T($"stat_{i}_label")</span>
                </div>
            }
        </div>
    </div>
    <div class="partners-logos">
        @foreach (var logo in partnerLogos)
        {
            <div class="partners-logos__tile">
                <img src="~/images/partners/@(logo).png" alt="@logo" loading="lazy" />
            </div>
        }
    </div>
</section>

<section class="wholesale">
    <h2 class="wholesale__heading">@T("wholesale_heading")</h2>
    <div class="wholesale__panel">
        <div class="wholesale__image">
            <img src="@T("wholesale_image")" alt="Hộp quà HOÀI" loading="lazy" />
        </div>
        <form method="post" asp-action="Partners" class="wholesale__form">
            @Html.AntiForgeryToken()
            @if (TempData["WholesaleSubmitted"] is not null)
            {
                <p class="wholesale__success">Cảm ơn bạn đã gửi yêu cầu! Đội ngũ HOÀI sẽ liên hệ trong thời gian sớm nhất.</p>
            }
            @* Figma cho Tên và Họ mỗi ô một dòng riêng (Frame 121 và 122, cùng rộng 613);
               chỉ Điện thoại và Mã bưu điện mới chia đôi một hàng (Frame 344). *@
            <div class="simple-field">
                <label class="visually-hidden">Tên*</label>
                <input type="text" asp-for="FirstName" placeholder="Tên*" />
            </div>
            <div class="simple-field">
                <label class="visually-hidden">Họ*</label>
                <input type="text" asp-for="LastName" placeholder="Họ*" />
            </div>
            <div class="simple-field">
                <label class="visually-hidden">Email*</label>
                    <input type="email" asp-for="Email" placeholder="Email*" />
            </div>
            <div class="wholesale__row">
                <div class="simple-field">
                    <label class="visually-hidden">Điện thoại</label>
                    <input type="text" asp-for="Phone" placeholder="Điện thoại" />
                </div>
                <div class="simple-field">
                    <label class="visually-hidden">Mã bưu điện</label>
                    <input type="text" asp-for="PostalCode" placeholder="Mã bưu điện" />
                </div>
            </div>
            <div class="simple-field">
                <label class="visually-hidden">Tên doanh nghiệp*</label>
                    <input type="text" asp-for="CompanyName" placeholder="Tên doanh nghiệp*" />
            </div>

            <div class="wholesale__request-type">
                <label>Loại yêu cầu</label>
                <label class="wholesale__radio"><input type="radio" asp-for="RequestType" value="Business" /> Kinh doanh</label>
                <label class="wholesale__radio"><input type="radio" asp-for="RequestType" value="CorporateGift" /> Quà doanh nghiệp</label>
            </div>

            <div class="simple-field">
                <label class="visually-hidden">Tin nhắn</label>
                <textarea asp-for="Message" rows="4" placeholder="Tin nhắn :"></textarea>
            </div>

            <button type="submit" class="wholesale__submit">Gửi</button>
        </form>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/partners.css" asp-append-version="true" />
}
