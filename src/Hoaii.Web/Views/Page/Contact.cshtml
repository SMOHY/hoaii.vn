@model Hoaii.Web.Models.Page.ContactFormModel
@{
    ViewData["Title"] = "Liên hệ";
    ViewData["HeroOverlay"] = true;
}

@* Hero sits on brand red with the nav overlaid (node 809:29894). Figma's breadcrumb
   still reads "Mua quà tết" on both breakpoints — using the page's own name. *@
<section class="contact-hero">
    <div class="contact-hero__inner">
        <div class="contact-hero__text">
            <p class="contact-breadcrumb"><a href="/">Trang chủ</a>/<span>Liên hệ</span></p>
            <h1 class="contact-hero__title">LIÊN HỆ</h1>
        </div>
        <div class="contact-hero__aside">
            <div class="contact-hero__img">
                <img src="~/images/contact/hero.jpg" alt="Hộp quà HOÀI" />
            </div>
            <p class="contact-hero__caption">Hãy liên hệ với chúng tôi</p>
        </div>
    </div>
</section>

<section class="contact-address">
    <h2 class="contact-section__heading">Địa chỉ</h2>
    <div class="contact-address__row">
        <a class="contact-address__img" href="https://maps.google.com/?q=945+Ngô+Gia+Tự,+Việt+Hưng,+Hà+Nội" target="_blank" rel="noopener">
            <img src="~/images/contact/map.jpg" alt="Bản đồ tới HOÀI" loading="lazy" />
            @* Google Maps place card, overlaid top-left of the map (node 970:20952). *@
            <img class="contact-address__map-card" src="~/images/contact/map-card.png" alt="" loading="lazy" />
        </a>
        <p class="contact-address__text">945 Ngô Gia Tự, P. Việt Hưng,<br />TP. Hà Nội</p>
    </div>
</section>

<section class="contact-methods">
    <h2 class="contact-section__heading">Liên hệ</h2>
    <div class="contact-methods__grid">
        <div class="contact-method-card">
            <h3>TRÒ CHUYỆN TRỰC TIẾP</h3>
            <p>Hãy truy cập facebook hoặc zalo của chúng tôi để nói chuyện trực tiếp với đội ngũ chăm sóc khách hàng về bất kỳ thắc mắc nào.</p>
            <a href="https://facebook.com" target="_blank" rel="noopener" class="contact-method-card__link">Liên hệ facebook</a>
        </div>
        <div class="contact-method-card">
            <h3>LIÊN QUAN ĐẾN ĐƠN HÀNG</h3>
            <p>Hãy truy cập facebook hoặc zalo của chúng tôi để nói chuyện trực tiếp với đội ngũ chăm sóc khách hàng về bất kỳ thắc mắc nào.</p>
            <button type="button" class="contact-method-card__link" data-contact-popup-open>Trò chuyện trực tiếp</button>
        </div>
        <div class="contact-method-card">
            <h3>YÊU CẦU BÁN BUÔN</h3>
            <p>Bạn muốn xem mẫu? Vui lòng gửi email cho chúng tôi</p>
            <a href="mailto:hoai@gmail.com" class="contact-method-card__link">Hoai@gmail.com</a>
        </div>
        <div class="contact-method-card">
            <h3>ĐIỆN THOẠI</h3>
            <p>Hãy gửi cho chúng tôi một lời nhắn</p>
            <a href="tel:0335006783" class="contact-method-card__link">033 500 6783</a>
        </div>
    </div>
</section>

<section class="contact-form-section">
    <h2 class="contact-section__heading">Hãy gửi email cho chúng tôi</h2>
    <div class="contact-form-section__row">
        <p class="contact-form-section__intro">Chúng tôi rất vui vì điều gì đó ở đây đã thu hút sự chú ý của bạn. Hãy liên hệ để chào hỏi, trao đổi về nhu cầu của bạn và cùng nhau tìm hiểu cách hợp tác nhé.</p>
        <form method="post" asp-action="Contact" class="contact-form">
            @Html.AntiForgeryToken()
            @if (TempData["ContactSubmitted"] is not null)
            {
                <p class="contact-form__success">Cảm ơn bạn đã liên hệ! Chúng tôi sẽ phản hồi sớm nhất có thể.</p>
            }
            @* Figma stacks every field full-width with the label as the field's own text (node 809:30314). *@
            <input type="text" asp-for="FirstName" class="contact-form__field" placeholder="Tên*" />
            <input type="text" asp-for="LastName" class="contact-form__field" placeholder="Họ*" />
            <input type="email" asp-for="Email" class="contact-form__field" placeholder="Email*" />
            <input type="text" asp-for="Phone" class="contact-form__field" placeholder="Điện thoại" />
            <textarea asp-for="Message" class="contact-form__field contact-form__field--message" placeholder="Tin nhắn :"></textarea>
            <button type="submit" class="contact-form__submit">Gửi</button>
        </form>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
}
