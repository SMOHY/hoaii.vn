@model Hoaii.Web.Models.Page.ContactFormModel
@using Hoaii.Web.Services
@inject SiteSettingsService Settings
@inject PageContentService PageC
@{
    ViewData["Title"] = "Liên hệ";
    ViewData["MetaDescription"] = "Liên hệ HOÀI — thông tin cửa hàng, số điện thoại và biểu mẫu hỗ trợ.";
    ViewData["HeroOverlay"] = true;
    var contactEmail = Settings.Get(SiteSettingKeys.ContactEmail);
    var contactPhone = Settings.Get(SiteSettingKeys.ContactPhone);
    var contactAddress = Settings.Get(SiteSettingKeys.Address);
    var facebookUrl = Settings.Get(SiteSettingKeys.FacebookUrl);
    var telDigits = new string(contactPhone.Where(char.IsDigit).ToArray());
    string C(string k) => PageC.Get(PageContentKeys.Contact, k);
}

@* Hero sits on brand red with the nav overlaid (node 809:29894). Figma's breadcrumb
   still reads "Mua quà tết" on both breakpoints — using the page's own name. *@
<section class="contact-hero">
    <div class="contact-hero__inner">
        <div class="contact-hero__text">
            <p class="contact-breadcrumb"><a href="/">Trang chủ</a>/<span>Liên hệ</span></p>
            <h1 class="contact-hero__title">@C("hero_title")</h1>
        </div>
        <div class="contact-hero__aside">
            <div class="contact-hero__img">
                <img src="@C("hero_image")" alt="Hộp quà HOÀI" />
            </div>
            <p class="contact-hero__caption">@C("hero_caption")</p>
        </div>
    </div>
</section>

<section class="contact-address">
    <h2 class="contact-section__heading">@C("address_heading")</h2>
    <div class="contact-address__row">
        <a class="contact-address__img" href="@C("map_url")" target="_blank" rel="noopener">
            <img src="@C("map_image")" alt="Bản đồ tới HOÀI" loading="lazy" />
            @* Google Maps place card, overlaid top-left of the map (node 970:20952). *@
            <img class="contact-address__map-card" src="@C("map_card_image")" alt="" loading="lazy" />
        </a>
        <p class="contact-address__text">@contactAddress</p>
    </div>
</section>

<section class="contact-methods">
    <h2 class="contact-section__heading">@C("methods_heading")</h2>
    <div class="contact-methods__grid">
        <div class="contact-method-card">
            <h3>@C("method_1_title")</h3>
            <p>@C("method_1_text")</p>
            <a href="@facebookUrl" target="_blank" rel="noopener" class="contact-method-card__link">@C("method_1_link_label")</a>
        </div>
        <div class="contact-method-card">
            <h3>@C("method_2_title")</h3>
            <p>@C("method_2_text")</p>
            <button type="button" class="contact-method-card__link" data-contact-popup-open>@C("method_2_link_label")</button>
        </div>
        <div class="contact-method-card">
            <h3>@C("method_3_title")</h3>
            <p>@C("method_3_text")</p>
            <a href="mailto:@contactEmail" class="contact-method-card__link">@contactEmail</a>
        </div>
        <div class="contact-method-card">
            <h3>@C("method_4_title")</h3>
            <p>@C("method_4_text")</p>
            <a href="tel:@telDigits" class="contact-method-card__link">@contactPhone</a>
        </div>
    </div>
</section>

<section class="contact-form-section">
    <h2 class="contact-section__heading">@C("form_heading")</h2>
    <div class="contact-form-section__row">
        <p class="contact-form-section__intro">@C("form_intro")</p>
        <form method="post" asp-action="Contact" class="contact-form">
            @Html.AntiForgeryToken()
            @if (TempData["ContactSubmitted"] is not null)
            {
                <p class="contact-form__success">@C("form_success")</p>
            }
            @* Figma stacks every field full-width with the label as the field's own text (node 809:30314). *@
            <input type="text" asp-for="FirstName" class="contact-form__field" placeholder="Tên*" />
            <input type="text" asp-for="LastName" class="contact-form__field" placeholder="Họ*" />
            <input type="email" asp-for="Email" class="contact-form__field" placeholder="Email*" />
            <input type="text" asp-for="Phone" class="contact-form__field" placeholder="Điện thoại" />
            <textarea asp-for="Message" class="contact-form__field contact-form__field--message" placeholder="Tin nhắn :"></textarea>
            <button type="submit" class="contact-form__submit">Gửi</button>
        </form>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
}
