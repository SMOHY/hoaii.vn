@model Hoaii.Web.Models.Blog.BlogIndexViewModel
@using Hoaii.Web.Services
@inject PageContentService PageC
@{
    ViewData["Title"] = "Blog";
    ViewData["MetaDescription"] = "Blog HOÀI — câu chuyện văn hóa Việt, gợi ý quà tặng và cẩm nang chọn quà cho từng dịp.";
}

<div class="blog-hero">
    <p class="blog-breadcrumb"><span>Trang chủ/</span><span class="blog-breadcrumb__current">Blog</span></p>
    <h1 class="blog-heading">@PageC.Get(PageContentKeys.Shop, "blog_page_heading")</h1>
</div>

@if (Model.Featured is not null)
{
    <div class="blog-featured">
        <a class="blog-featured__img" href="@Model.Featured.Url" aria-label="@Model.Featured.Title" style="@(Model.Featured.ImageUrl is not null ? $"background-image:url('{Model.Featured.ImageUrl}')" : "")"></a>
        <div class="blog-featured__body">
            <div class="blog-featured__top">
                <span class="blog-featured__category">@Model.Featured.Category</span>
                <h2 class="blog-featured__title"><a href="@Model.Featured.Url">@Model.Featured.Title</a></h2>
                @if (!string.IsNullOrEmpty(Model.Featured.Excerpt))
                {
                    <p class="blog-featured__excerpt">@Model.Featured.Excerpt</p>
                }
                <span class="blog-featured__date">@Model.Featured.DateText</span>
            </div>
            <a href="@Model.Featured.Url" class="btn--dark">Xem bài viết</a>
        </div>
    </div>
}

<div class="blog-grid">
    @foreach (var post in Model.Posts)
    {
        <a class="blog-card" href="@post.Url">
            <div class="blog-card__img" style="@(post.ImageUrl is not null ? $"background-image:url('{post.ImageUrl}')" : "")"></div>
            <div class="blog-card__meta">
                <span class="blog-card__category">@post.Category</span>
                <h3 class="blog-card__title">@post.Title</h3>
                @if (!string.IsNullOrEmpty(post.Excerpt))
                {
                    <p class="blog-card__excerpt">@post.Excerpt</p>
                }
            </div>
            <span class="blog-card__date">@post.DateText</span>
        </a>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
}
