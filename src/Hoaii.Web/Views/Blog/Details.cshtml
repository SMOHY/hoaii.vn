@model Hoaii.Web.Models.Blog.BlogPostDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = Model.Excerpt is { Length: > 0 } ex ? ex : Model.Title;
}

@* No Figma spec exists for the blog post detail template — this is a minimal, typography-consistent
   placeholder so listing links have a real destination. Extend once a design is provided. *@
<div class="container" style="padding: 40px 24px 80px; max-width: 800px;">
    <p style="color:var(--color-brand-gold); font:500 16px/20px var(--font-body); margin:0 0 16px;">@Model.Category</p>
    <h1 style="font-family:var(--font-display); font-size:40px; margin:0 0 8px;">@Model.Title</h1>
    <p style="color:var(--color-grey-500); font:500 16px/20px var(--font-body); margin:0 0 32px;">
        @Model.DateText@(string.IsNullOrWhiteSpace(Model.Author) ? "" : $" · {Model.Author}")
    </p>
    <div class="blog-featured__img" style="height:420px; @(Model.ImageUrl is not null ? $"background-image:url('{Model.ImageUrl}')" : "")"></div>

    @* Body first (what the admin writes in the CMS); the excerpt is only a fallback for
       legacy posts that have no content yet. Paragraphs split on blank lines. *@
    @{
        var body = !string.IsNullOrWhiteSpace(Model.Content) ? Model.Content : Model.Excerpt;
    }
    @if (!string.IsNullOrWhiteSpace(body))
    {
        <div style="margin-top:32px; font:300 20px/1.6 var(--font-body); color:var(--color-grey-700);">
            @foreach (var para in body.Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
            {
                <p style="margin:0 0 20px; white-space:pre-line;">@para.Trim()</p>
            }
        </div>
    }
    <a href="/blog" style="display:inline-block; margin-top:32px; color:var(--color-brand-red); text-decoration:underline;">← Quay lại Blog</a>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
}
