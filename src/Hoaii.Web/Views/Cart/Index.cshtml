@model Hoaii.Web.Models.Cart.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

@* Was a single "Trang chủ/Giỏ hàng" string with no link and no landmark. Figma draws the same
   line (node 1154:36001); this renders it as a real trail so the first crumb works and assistive
   tech can announce where the page sits. *@
<nav class="cart-breadcrumb" aria-label="Breadcrumb">
    <ol>
        <li><a href="/">Trang chủ</a></li>
        <li aria-current="page">Giỏ hàng</li>
    </ol>
</nav>

@* The page had no h1 at all. Figma leads with the breadcrumb and goes straight to the panel, so
   the heading is visually hidden rather than invented into the design. *@
<h1 class="visually-hidden">Giỏ hàng</h1>

<div class="cart-page" data-cart-region="cart-page">
    @if (Model.Items.Count == 0)
    {
        <div class="cart-panel cart-panel--empty">
            <p>Giỏ hàng của bạn đang trống.</p>
            <a href="/" class="cart-empty__cta">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="cart-panel">
            <div class="cart-panel__items">
                @foreach (var item in Model.Items)
                {
                    <partial name="_CartItemRow" model="item" />
                }
            </div>

            @if (Model.AddOnSuggestions.Count > 0)
            {
                <div class="cart-addons">
                    <p class="cart-addons__heading">HOÀN CHỈNH VỚI</p>
                    <div class="cart-addons__list">
                        @foreach (var addOn in Model.AddOnSuggestions)
                        {
                            <partial name="_CartAddOnRow" model="addOn" />
                        }
                    </div>
                </div>
            }

            <div class="cart-discount">
                <span>Giảm giá</span>
                <span class="cart-discount__value">@Model.Discount.ToString("N0")đ</span>
            </div>

            <div class="cart-summary">
                <div class="cart-summary__totals">
                    <span class="cart-summary__label">Tổng cộng</span>
                    <span class="cart-summary__amount">@Model.Total.ToString("N0")đ</span>
                </div>
                <a href="/thanh-toan" class="cart-summary__checkout">Thanh toán</a>
            </div>
        </div>
    }
</div>
