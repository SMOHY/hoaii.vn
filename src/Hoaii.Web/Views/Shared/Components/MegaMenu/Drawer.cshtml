@using Hoaii.Web.Models.Layout
@using Hoaii.Web.Services
@inject NavigationService Nav
@model IReadOnlyList<Hoaii.Web.Models.Layout.MegaMenuPanelViewModel>
@* The mega-menu panels open on hover, which never happens on a phone — so every sub-category
   link in them used to be unreachable on mobile. Same data, rendered as an accordion. *@
@{
    // Panel component chỉ dựng nội dung cho các mục có tick "Dropdown" — mục nào không tick thì
    // Model không có panel tương ứng, phải render thẳng một link thường, không thì mục đó biến
    // mất khỏi menu mobile hoàn toàn (đúng bug đã gặp ở desktop trước khi sửa _Nav.cshtml).
    var panelsByKey = Model.ToDictionary(p => p.CategoryKey);
}
@foreach (var item in Nav.MainMenu)
{
    var key = item.Url.Split('/').Last();
    if (panelsByKey.TryGetValue(key, out var panel))
    {
        <div class="nav-drawer__group" data-drawer-group>
            <button type="button" class="nav-drawer__group-toggle" data-drawer-toggle aria-expanded="false">
                <span>@item.Label</span>
                <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" />
                </svg>
            </button>
            <div class="nav-drawer__sub" data-drawer-sub hidden>
                @foreach (var column in panel.Columns.Where(c => c.Links.Count > 0))
                {
                    <p class="nav-drawer__sub-title">@column.Title</p>
                    @foreach (var link in column.Links)
                    {
                        <a href="@link.Url">@link.Label</a>
                    }
                }
                <a class="nav-drawer__see-all" href="@panel.SeeAllUrl">Xem tất cả @item.Label.ToLowerInvariant()</a>
            </div>
        </div>
    }
    else
    {
        <div class="nav-drawer__group">
            <a class="nav-drawer__group-toggle" href="@item.Url">
                <span>@item.Label</span>
            </a>
        </div>
    }
}
