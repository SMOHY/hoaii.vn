@*
    A storefront image with an optional mobile replacement and an optional focal point.

    With neither set — the state every image starts in — this renders exactly the <img> the view
    used to write by hand. The <picture> wrapper appears only once an admin has actually chosen a
    separate mobile image, so the rendered page is unchanged until someone asks for a change.
*@
@using Hoaii.Web.Models
@using Hoaii.Web.Services
@model ResponsiveImage
@{
    // Validated in FocalPoint, never trusted here: a value that isn't a percentage pair is
    // dropped rather than written into the style attribute.
    var focal = FocalPoint.Style(Model.Focal);
}
@if (string.IsNullOrWhiteSpace(Model.MobileSrc))
{
    <img src="@Model.Src" alt="@Model.Alt" class="@Model.CssClass" loading="@Model.Loading" fetchpriority="@Model.FetchPriority" style="@focal" />
}
else
{
    <picture>
        <source media="(max-width: 767.98px)" srcset="@Model.MobileSrc" />
        <img src="@Model.Src" alt="@Model.Alt" class="@Model.CssClass" loading="@Model.Loading" fetchpriority="@Model.FetchPriority" style="@focal" />
    </picture>
}
