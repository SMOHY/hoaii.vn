@* Account pages run on the same stripped-back chrome as checkout — logo plus an avatar,
   no nav and no footer (Figma node 848:20065). *@
@{
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? User.Identity?.Name
                ?? "";
    var initial = string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hoài</title>
    @* Preload the two faces used above the fold — body text (Medium) and the display serif
       every heading is set in. Without this the page paints in a fallback and reflows. *@
    <link rel="preload" href="/fonts/Josefin Sans/JosefinSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/LC Sac/LCSac Trial-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @* Last, so the touch-target sizes win over the page stylesheets without !important. *@
    <link rel="stylesheet" href="~/css/touch.css" asp-append-version="true" />
</head>
<body class="account-body">
    <a class="skip-link" href="#main">Bỏ qua, tới nội dung chính</a>
    <header class="account-nav">
        <div class="account-nav__inner">
            <a class="account-nav__logo" href="/" aria-label="Hoài">
                <img src="~/images/logo.svg" alt="Hoài" width="64" height="64" />
            </a>
            <span class="account-nav__avatar" title="@email">@initial</span>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/overlays.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
