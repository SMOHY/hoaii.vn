@* Account pages run on stripped-back chrome — logo plus an avatar, no nav (Figma node
   848:20065). Figma draws these screens without a footer, but the shop wants the same footer
   on every customer-facing page, so the shared _Footer partial is rendered here too. *@
@{
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? User.Identity?.Name
                ?? "";
    var initial = string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hoài</title>
    <meta name="robots" content="noindex, follow" />
    @* Preload the two faces used above the fold — body text (Medium) and the display serif
       every heading is set in. Without this the page paints in a fallback and reflows. *@
    <link rel="preload" href="/fonts/Josefin Sans/JosefinSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/LC Sac/LCSac Trial-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @* Last, so the touch-target sizes win over the page stylesheets without !important. *@
    <link rel="stylesheet" href="~/css/touch.css" asp-append-version="true" />
</head>
<body class="account-body">
    <a class="skip-link" href="#main">Bỏ qua, tới nội dung chính</a>
    <header class="account-nav">
        <div class="account-nav__inner">
            @* Chỉ hiện trên mobile — mở drawer nav tài khoản (Figma node 1265:39388). Desktop
               ẩn nút này, logo tự về mép trái. *@
            <button type="button" class="account-nav__menu-btn" data-account-menu-open aria-label="Mở menu tài khoản" aria-expanded="false" aria-controls="account-drawer">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <a class="account-nav__logo" href="/" aria-label="Hoài">
                <img src="~/images/logo.svg" alt="Hoài" width="64" height="64" />
            </a>
            <span class="account-nav__avatar" title="@email">@initial</span>
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    @* Same shared footer as the rest of the storefront. *@
    <partial name="_Footer" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/overlays.js" asp-append-version="true"></script>
    @* Drawer nav tài khoản (chỉ dùng trên mobile). Nhỏ gọn nên để inline thay vì thêm file. *@
    <script>
        (function () {
            var drawer = document.getElementById('account-drawer');
            var openBtn = document.querySelector('[data-account-menu-open]');
            if (!drawer || !openBtn) return;
            var closeBtn = drawer.querySelector('[data-account-menu-close]');
            function open() { drawer.classList.add('is-open'); document.body.style.overflow = 'hidden'; openBtn.setAttribute('aria-expanded', 'true'); }
            function close() { drawer.classList.remove('is-open'); document.body.style.overflow = ''; openBtn.setAttribute('aria-expanded', 'false'); }
            openBtn.addEventListener('click', open);
            if (closeBtn) closeBtn.addEventListener('click', close);
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && drawer.classList.contains('is-open')) close(); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
