@using Microsoft.AspNetCore.Html
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hoài</title>
    @* Follows the ViewData["Title"] convention: a page sets these when it has real copy for
       them. The canonical deliberately drops sort/filter so those combinations don't read as
       separate pages; `page` is kept because each page really is different content. *@
    @if (ViewData["MetaDescription"] is string metaDescription && metaDescription.Length > 0)
    {
        <meta name="description" content="@metaDescription" />
    }
    @* Cart/checkout/account/search hold per-user or query-driven content with nothing for a
       crawler to rank — indexing them just dilutes the site with duplicate/empty pages. *@
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, follow" />
    }
    @{
        var canonicalPage = Context.Request.Query["page"].ToString();
        var canonicalPath = Context.Request.Path.ToString();
        var siteOrigin = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var canonical = siteOrigin + canonicalPath
            + (canonicalPage.Length > 0 && canonicalPage != "1" ? $"?page={canonicalPage}" : "");
    }
    <link rel="canonical" href="@canonical" />
    @{
        // Product/blog pages hand in their own shot via OgImage; everything else falls back to
        // the brand mark so a bare link (chat, Zalo, Facebook) never posts with no image at all.
        var ogTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string ?? "Hoài";
        // Facebook/Zalo don't render SVG previews, so the fallback needs a raster image.
        var ogImage = ViewData["OgImage"] as string ?? "/apple-touch-icon.png";
        if (!ogImage.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            ogImage = siteOrigin + ogImage;
        }
    }
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:site_name" content="Hoài" />
    <meta property="og:title" content="@ogTitle" />
    @if (ViewData["MetaDescription"] is string ogDescription && ogDescription.Length > 0)
    {
        <meta property="og:description" content="@ogDescription" />
    }
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:image" content="@ogImage" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    @* Preload the two faces used above the fold — body text (Medium) and the display serif
       every heading is set in. Without this the page paints in a fallback and reflows. *@
    <link rel="preload" href="/fonts/Josefin Sans/JosefinSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/LC Sac/LCSac Trial-Regular.woff2" as="font" type="font/woff2" crossorigin />
    @* The biggest image on most pages is a CSS background, which the browser only discovers
       after it has parsed the stylesheet. Pages that know their hero name it here. *@
    @if (ViewData["PreloadImage"] is string preloadImage && preloadImage.Length > 0)
    {
        <link rel="preload" href="@preloadImage" as="image" fetchpriority="high" />
    }
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat-widget.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modals.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @* Last, so the touch-target sizes win over the page stylesheets without !important. *@
    <link rel="stylesheet" href="~/css/touch.css" asp-append-version="true" />
    @* Undoes the banner and body offset the Google Translate widget injects. Loaded after
       touch.css so its overrides sit at the end of the cascade. *@
    <link rel="stylesheet" href="~/css/google-translate.css" asp-append-version="true" />
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "Hoài",
        "url": "@siteOrigin",
        "logo": "@(siteOrigin)/apple-touch-icon.png"
    }
    </script>
    @if (ViewData["StructuredData"] is IHtmlContent structuredData)
    {
        @structuredData
    }
</head>
<body class="@(ViewData["HeroOverlay"] as bool? == true ? "hero-overlay" : "")">
    <a class="skip-link" href="#main">Bỏ qua, tới nội dung chính</a>
    <partial name="_Nav" />

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <partial name="_Footer" />
    <partial name="_ChatWidget" />
    <partial name="_ContactPopup" />
    @await Component.InvokeAsync("MiniCart")

    @* Mount point for the Google Translate widget. It has to exist in the DOM before
       element.js runs, and it has to stay visible to CSS — google-translate.css moves it
       off-screen rather than hiding it, because display:none stops the widget working. *@
    <div id="google_translate_element" aria-hidden="true"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/overlays.js" asp-append-version="true"></script>
    <script src="~/js/cart-live.js" asp-append-version="true"></script>
    <script src="~/js/addon-sheet.js" asp-append-version="true"></script>
    <script src="~/js/form-validate.js" asp-append-version="true"></script>
    @* Must load before element.js: it defines the googleTranslateElementInit callback that
       element.js invokes via its ?cb= parameter. *@
    <script src="~/js/lang-switch.js" asp-append-version="true"></script>
    <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
