@using Hoaii.Web.Models.Layout
@using Hoaii.Web.Services
@inject SiteSettingsService Settings
@inject NavigationService Nav
@{
    var footerColumns = Nav.FooterColumns;
}

<footer class="footer">
    <div class="footer-newsletter">
        <h2>ĐĂNG KÝ VÀO DANH SÁCH</h2>
        <p>Cập nhật sớm nhất thông tin sản phẩm mới và những đặc quyền giới hạn từ HOÀI!</p>
        <form class="footer-signup" method="post" action="/newsletter/subscribe" data-async-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <input type="email" name="email" placeholder="Nhập email của bạn" required />
            <button type="submit">Gửi</button>
        </form>
        @if (TempData["NewsletterSubscribed"] is not null)
        {
            <p class="footer-signup__done" role="status">Cảm ơn bạn! Chúng tôi sẽ gửi tin mới nhất tới hộp thư của bạn.</p>
        }
    </div>

    <div class="footer-links-section">
        <div class="footer-links-row">
            <div class="footer-brand">
                <img class="logo" src="/images/logo.svg" alt="Hoài" />
                <div class="footer-brand-info">
                    <span>@Settings.Get(SiteSettingKeys.CompanyName)</span>
                    <span>Địa chỉ : @Settings.Get(SiteSettingKeys.Address)</span>
                    <a href="https://masothue.com" target="_blank" rel="noopener">MST : @Settings.Get(SiteSettingKeys.TaxCode)</a>
                </div>
            </div>

            @* SOCIAL is not a column of its own — Figma tucks it under "Chính sách pháp lý"
               (node 683:4413), so the footer is three link columns, not four. *@
            @for (var i = 0; i < footerColumns.Count; i++)
            {
                var column = footerColumns[i];
                var isLast = i == footerColumns.Count - 1;
                <div class="footer-col @(isLast ? "footer-col--with-social" : "")">
                    <h3>@column.Title</h3>
                    <ul>
                        @foreach (var link in column.Links)
                        {
                            <li><a href="@link.Url">@link.Label</a></li>
                        }
                    </ul>

                    @if (isLast)
                    {
                        // URLs come from settings so the shop owner can point them at real
                        // accounts; the icons stay fixed.
                        var socials = new[]
                        {
                            ("Facebook", Settings.Get(SiteSettingKeys.FacebookUrl), "/images/icons/social-facebook.svg"),
                            ("Instagram", Settings.Get(SiteSettingKeys.InstagramUrl), "/images/icons/social-instagram.svg"),
                            ("TikTok", Settings.Get(SiteSettingKeys.TiktokUrl), "/images/icons/social-tiktok.svg"),
                        };
                        <div class="footer-social">
                            <h3>SOCIAL</h3>
                            <div class="icons-row">
                                @foreach (var (name, url, icon) in socials)
                                {
                                    <a class="icon-btn" href="@url" target="_blank" rel="noopener" aria-label="@name">
                                        <img src="@icon" alt="@name" width="24" height="24" />
                                    </a>
                                }
                            </div>
                            <div class="footer-badge">
                                <img src="/images/bo-cong-thuong-badge.svg" alt="Đã thông báo Bộ Công Thương" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</footer>
