@model Hoaii.Web.Models.Account.OrderCardViewModel
@* Thẻ đơn hàng — Figma node 848:14779 (Frame 460): một hàng space-between, bên trái là dòng
   sản phẩm (thumb + tên/biến thể/giá xếp dọc), bên phải là pill trạng thái. Figma KHÔNG có mã
   đơn, ngày, tổng hay nút — và hai nút "Xem chi tiết"/"Mua lại" cũ đều href="#" (link chết,
   chưa có trang chi tiết đơn), nên bỏ luôn. *@
<div class="order-card">
    <div class="order-card__items">
        @foreach (var item in Model.Items)
        {
            <div class="order-line">
                <div class="order-line__thumb" style="@(item.ThumbnailUrl is not null ? $"background-image:url('{item.ThumbnailUrl}')" : "")"></div>
                <div class="order-line__info">
                    <div class="order-line__title">
                        <span class="order-line__name">@item.Name</span>
                        @if (!string.IsNullOrEmpty(item.VariantLabel))
                        {
                            <span class="order-line__variant">@item.VariantLabel</span>
                        }
                    </div>
                    @* Figma chỉ hiện giá; giữ "× N" khi số lượng > 1 vì đó là thông tin thật cần thấy. *@
                    <span class="order-line__price">@item.Price.ToString("N0")đ@(item.Quantity > 1 ? $" × {item.Quantity}" : "")</span>
                </div>
            </div>
        }
    </div>
    <span class="order-status-badge">@Model.StatusLabel</span>
</div>
