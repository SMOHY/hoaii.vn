@model Hoaii.Web.Models.Category.ProductCardViewModel
@* Reusable product card — see design-specs/category-page-template.md *@
@{
    var swatchPalette = new[] { "#E60000", "#0077FF", "#FFC300", "#00E007" };
    var isOutOfStock = Model.BadgeVariant == "out-of-stock";

    // The collection tile on the product page carries the name and nothing else — no price,
    // no swatches (node 826:20692).
    var isCollection = Model.CardVariant == "collection";
}
<div class="product-card product-card--@Model.CardVariant @(isOutOfStock ? "product-card--out-of-stock" : "")">
    <div class="product-card__image" style="@(Model.ImageUrl is not null ? $"background-image:url('{Model.ImageUrl}')" : "")">
        <a class="product-card__image-link" href="/san-pham/@Model.Slug" aria-label="@Model.Name"></a>
        @* Figma keeps the "Hàng mới" / "-20%" badges in the component but ships them hidden
           (node 722:18122, Frame 54), so they only show for out-of-stock. *@
        @if (isOutOfStock)
        {
            <div class="product-card__badges">
                <span class="product-card__badge product-card__badge--@Model.BadgeVariant">@Model.BadgeLabel</span>
            </div>
        }
        @if (!isOutOfStock)
        {
            <form method="post" action="/gio-hang/them" class="product-card__add-to-cart">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" aria-label="Thêm vào giỏ">
                    <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 6v16M6 14h16" stroke="currentColor" stroke-width="2"/></svg>
                    <span class="cta-label">Thêm vào giỏ</span>
                </button>
            </form>
        }
    </div>
    <div class="product-card__info">
        <a href="/san-pham/@Model.Slug" class="product-card__name">@Model.Name</a>
        @if (!isCollection)
        {
            <p class="product-card__price">
                @Model.Price.ToString("N0") VNĐ
                @if (Model.CompareAtPrice is not null)
                {
                    <span class="product-card__compare-price">@Model.CompareAtPrice.Value.ToString("N0") VNĐ</span>
                }
            </p>
            @if (Model.VariantCount > 1)
            {
                <div class="product-card__swatches">
                    @for (var i = 0; i < Math.Min(Model.VariantCount, swatchPalette.Length); i++)
                    {
                        <span class="product-card__swatch @(i == 0 ? "product-card__swatch--active" : "")" style="background-color:@swatchPalette[i]"></span>
                    }
                </div>
            }
        }
    </div>
</div>
