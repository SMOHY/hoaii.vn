@using Hoaii.Web.Models.Layout
@using Hoaii.Web.Services
@inject SiteSettingsService Settings
@inject NavigationService Nav
@{
    var mainMenu = Nav.MainMenu;
    var subNav = Nav.SubNavLinks;
}

@* Icons below are inline SVG placeholders — replace with exported Figma assets under wwwroot/images/icons/. *@

<header class="nav-desktop">
    <div class="nav-announcement">
        <span>Hotline: @Settings.Get(SiteSettingKeys.Hotline)</span>
    </div>
    <div class="nav-subbar">
        <div class="nav-subbar-inner">
            <div class="nav-subbar-left">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.4 7.2H22l-6 4.5 2.4 7.3L12 16.5 5.6 21l2.4-7.3L2 9.2h7.6L12 2z" fill="currentColor"/></svg>
                <span>@Settings.Get(SiteSettingKeys.AnnouncementText)</span>
            </div>
            <div class="nav-subbar-right">
                @foreach (var link in subNav)
                {
                    <a href="@link.Url">@link.Label</a>
                }
            </div>
        </div>
    </div>
    <div class="nav-main">
        <div class="nav-main-inner">
            @* Two files rather than one recoloured by CSS: an <img>-embedded SVG doesn't
               inherit the page's styles, so a single white logo vanished on every
               white-background nav. *@
            <a class="nav-logo" href="/" aria-label="Hoài">
                <img class="nav-logo__dark" src="/images/logo.svg" alt="Hoài" width="48" height="48" />
                <img class="nav-logo__light" src="/images/logo-white.svg" alt="" width="48" height="48" aria-hidden="true" />
            </a>
            <nav class="nav-menu" data-mega-menu-nav>
                @foreach (var item in mainMenu)
                {
                    var menuKey = item.Url.Split('/').Last();
                    <button type="button" class="item" data-menu-trigger="@menuKey" aria-expanded="false">
                        <span>@item.Label</span>
                        @if (item.HasDropdown)
                        {
                            <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                        }
                    </button>
                }
            </nav>
            <div class="nav-icons">
                <button class="icon-btn" type="button" aria-label="Tìm kiếm" onclick="location.href='/tim-kiem'">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M5 10.7653C5.00003 8.01487 6.94296 5.64752 9.64053 5.11105C12.3381 4.57459 15.039 6.01842 16.0913 8.55953C17.1437 11.1006 16.2544 14.0313 13.9674 15.5591C11.6804 17.0869 8.63257 16.7863 6.688 14.8413C5.60716 13.7601 4.99998 12.294 5 10.7653Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16.5291 16.5293L19.0001 19.0003" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <a class="icon-btn" href="/tai-khoan" aria-label="Tài khoản">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M16 9C16 11.2091 14.2091 13 12 13C9.79086 13 8 11.2091 8 9C8 6.79086 9.79086 5 12 5C13.0609 5 14.0783 5.42143 14.8284 6.17157C15.5786 6.92172 16 7.93913 16 9Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 19C8.5 15 15.5 15 19 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </a>
                <a class="icon-btn nav-cart-btn" href="/gio-hang" aria-label="Giỏ hàng" data-minicart-open>
                    <svg width="19" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M18.931 11.9997L17.941 15.9997C17.117 18.9127 16.441 19.7477 14.97 19.9457C14.6416 19.9856 14.3108 20.0037 13.98 19.9997H10.02C9.68917 20.0037 9.35844 19.9856 9.03 19.9457C7.564 19.7457 6.883 18.9127 6.059 15.9997L5.069 11.9997C4.576 9.01373 6.822 8.00872 9 7.99973V7.12473C8.96596 5.43354 10.3088 4.03472 12 3.99973C13.6912 4.03472 15.034 5.43354 15 7.12473V7.99973C17.178 8.00872 19.423 9.01273 18.931 11.9997Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 8.74976C15.4142 8.74976 15.75 8.41397 15.75 7.99976C15.75 7.58554 15.4142 7.24976 15 7.24976V7.99976V8.74976ZM9 7.24976C8.58579 7.24976 8.25 7.58554 8.25 7.99976C8.25 8.41397 8.58579 8.74976 9 8.74976V7.99976V7.24976ZM15.75 9.99976C15.75 9.58554 15.4142 9.24976 15 9.24976C14.5858 9.24976 14.25 9.58554 14.25 9.99976H15H15.75ZM14.25 10.9998C14.25 11.414 14.5858 11.7498 15 11.7498C15.4142 11.7498 15.75 11.414 15.75 10.9998H15H14.25ZM9.75 9.99976C9.75 9.58554 9.41421 9.24976 9 9.24976C8.58579 9.24976 8.25 9.58554 8.25 9.99976H9H9.75ZM8.25 10.9998C8.25 11.414 8.58579 11.7498 9 11.7498C9.41421 11.7498 9.75 11.414 9.75 10.9998H9H8.25ZM15 7.99976V7.24976H9V7.99976V8.74976H15V7.99976ZM15 9.99976H14.25V10.9998H15H15.75V9.99976H15ZM9 9.99976H8.25V10.9998H9H9.75V9.99976H9Z" fill="currentColor"/></svg>
                    <span class="nav-cart-badge" data-cart-badge hidden>0</span>
                </a>
                <button class="nav-lang" type="button" aria-label="Ngôn ngữ">
                    VN/<span class="en">EN</span>
                </button>
            </div>
        </div>
    </div>
    @await Component.InvokeAsync("MegaMenu")
</header>

<header class="nav-mobile">
    <div class="nav-m-announcement">
        <span>Hotline: @Settings.Get(SiteSettingKeys.Hotline)</span>
    </div>
    <div class="nav-m-main">
        <div class="nav-m-main-inner">
            <button class="nav-m-hamburger" type="button" aria-label="Menu" data-nav-drawer-open aria-expanded="false" aria-controls="nav-drawer">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2"/></svg>
            </button>
            <a href="/" aria-label="Hoài">
                <img class="nav-m-logo nav-logo__dark" src="/images/logo.svg" alt="Hoài" width="36" height="36" />
                <img class="nav-m-logo nav-logo__light" src="/images/logo-white.svg" alt="" width="36" height="36" aria-hidden="true" />
            </a>
            <div class="nav-m-icons">
                <button class="icon-btn" type="button" aria-label="Tìm kiếm" onclick="location.href='/tim-kiem'">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M5 10.7653C5.00003 8.01487 6.94296 5.64752 9.64053 5.11105C12.3381 4.57459 15.039 6.01842 16.0913 8.55953C17.1437 11.1006 16.2544 14.0313 13.9674 15.5591C11.6804 17.0869 8.63257 16.7863 6.688 14.8413C5.60716 13.7601 4.99998 12.294 5 10.7653Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16.5291 16.5293L19.0001 19.0003" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <a class="icon-btn nav-cart-btn" href="/gio-hang" aria-label="Giỏ hàng" data-minicart-open>
                    <svg width="16" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M18.931 11.9997L17.941 15.9997C17.117 18.9127 16.441 19.7477 14.97 19.9457C14.6416 19.9856 14.3108 20.0037 13.98 19.9997H10.02C9.68917 20.0037 9.35844 19.9856 9.03 19.9457C7.564 19.7457 6.883 18.9127 6.059 15.9997L5.069 11.9997C4.576 9.01373 6.822 8.00872 9 7.99973V7.12473C8.96596 5.43354 10.3088 4.03472 12 3.99973C13.6912 4.03472 15.034 5.43354 15 7.12473V7.99973C17.178 8.00872 19.423 9.01273 18.931 11.9997Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 8.74976C15.4142 8.74976 15.75 8.41397 15.75 7.99976C15.75 7.58554 15.4142 7.24976 15 7.24976V7.99976V8.74976ZM9 7.24976C8.58579 7.24976 8.25 7.58554 8.25 7.99976C8.25 8.41397 8.58579 8.74976 9 8.74976V7.99976V7.24976ZM15.75 9.99976C15.75 9.58554 15.4142 9.24976 15 9.24976C14.5858 9.24976 14.25 9.58554 14.25 9.99976H15H15.75ZM14.25 10.9998C14.25 11.414 14.5858 11.7498 15 11.7498C15.4142 11.7498 15.75 11.414 15.75 10.9998H15H14.25ZM9.75 9.99976C9.75 9.58554 9.41421 9.24976 9 9.24976C8.58579 9.24976 8.25 9.58554 8.25 9.99976H9H9.75ZM8.25 10.9998C8.25 11.414 8.58579 11.7498 9 11.7498C9.41421 11.7498 9.75 11.414 9.75 10.9998H9H8.25ZM15 7.99976V7.24976H9V7.99976V8.74976H15V7.99976ZM15 9.99976H14.25V10.9998H15H15.75V9.99976H15ZM9 9.99976H8.25V10.9998H9H9.75V9.99976H9Z" fill="currentColor"/></svg>
                    <span class="nav-cart-badge" data-cart-badge hidden>0</span>
                </a>
            </div>
        </div>
    </div>
</header>

<div class="nav-drawer" id="nav-drawer" data-nav-drawer>
    <div class="nav-drawer__backdrop"></div>
    <div class="nav-drawer__panel">
        <button class="nav-drawer__close" type="button" aria-label="Đóng" data-nav-drawer-close>&times;</button>
        @await Component.InvokeAsync("MegaMenu", new { view = "Drawer" })
        <div class="nav-drawer__links">
            @foreach (var link in subNav)
            {
                <a href="@link.Url">@link.Label</a>
            }
        </div>
    </div>
</div>
