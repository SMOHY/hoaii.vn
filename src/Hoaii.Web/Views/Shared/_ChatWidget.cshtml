@using Hoaii.Web.Services
@inject SiteSettingsService Settings
@{
    var telDigits = new string(Settings.Get(SiteSettingKeys.ContactPhone).Where(char.IsDigit).ToArray());

    // Was hardcoded to the generic "https://m.me" (no page — opens Messenger's own homepage,
    // not a chat). Derive the shop's actual m.me deep link from the Facebook Page URL already
    // set in Cài đặt trang, so this button only needs the one Facebook field to be correct.
    var messengerUrl = "https://m.me";
    var fbUrl = Settings.Get(SiteSettingKeys.FacebookUrl);
    if (Uri.TryCreate(fbUrl, UriKind.Absolute, out var fbUri))
    {
        var pageName = fbUri.AbsolutePath.Trim('/');
        if (!string.IsNullOrEmpty(pageName) && !pageName.Contains("profile.php", StringComparison.OrdinalIgnoreCase))
        {
            messengerUrl = $"https://m.me/{pageName}";
        }
        else if (!string.IsNullOrEmpty(pageName))
        {
            // "profile.php?id=..." has no clean page-name segment for m.me — link to the Page itself.
            messengerUrl = fbUrl;
        }
    }
}
<div class="chat-widget is-collapsed" data-chat-widget>
    <button class="bubble bubble--phone" type="button" aria-label="Gọi điện" onclick="location.href='tel:@telDigits'">
        <img src="/images/icons/chat-phone.png" alt="" width="36" height="36" />
    </button>
    <a class="bubble bubble--zalo" href="@Settings.Get(SiteSettingKeys.ZaloUrl)" target="_blank" rel="noopener" aria-label="Zalo">
        <img src="/images/icons/chat-zalo.png" alt="Zalo" width="36" height="36" />
    </a>
    <a class="bubble bubble--messenger" href="@messengerUrl" target="_blank" rel="noopener" aria-label="Messenger">
        <img src="/images/icons/chat-messenger.png" alt="Messenger" width="36" height="36" />
    </a>
    <button class="toggle" type="button" aria-label="Mở/đóng liên hệ nhanh">
        <img class="toggle__icon-open" src="/images/icons/chat-toggle-collapsed.png" alt="" width="64" height="64" />
        <svg class="toggle__icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
</div>
<button class="back-to-top" type="button" aria-label="Lên đầu trang" data-back-to-top hidden>
    <img src="/images/icons/back-to-top-icon.png" alt="" width="38" height="38" />
</button>
