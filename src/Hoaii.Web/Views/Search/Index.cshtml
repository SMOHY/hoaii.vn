@model Hoaii.Web.Models.Search.SearchPageViewModel
@{
    ViewData["Title"] = "Tìm kiếm";
    var hasQuery = !string.IsNullOrEmpty(Model.Query);
    var hasResults = hasQuery && Model.TotalResultCount > 0;
}

<div class="search-header">
    @* Pragmatic addition beyond the Figma capture — the search input itself lives somewhere
       in the Nav per design-specs/search-page.md, but isn't rendered there; a visible box here
       keeps the page usable without JS. *@
    <form method="get" action="/tim-kiem" class="search-header__box">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2"/></svg>
        <input type="text" name="q" value="@Model.Query" placeholder="Tìm sản phẩm, danh mục..." autofocus />
    </form>

    @* The count sits above the heading in both states (nodes 988:21329 and 988:23680). The
       heading itself only belongs here when there is something to show — with no results the
       page's h1 is "KHÔNG CÓ KẾT QUẢ" below, and two h1s would be worse than none. *@
    @if (hasQuery)
    {
        <p class="search-header__count">@Model.TotalResultCount kết quả</p>
    }
    @if (hasResults)
    {
        <h1 class="search-header__title">KẾT QUẢ TÌM KIẾM CHO “@Model.Query.ToUpperInvariant()”</h1>
    }
</div>

@if (!hasQuery)
{
    @* Landing on /tim-kiem with nothing typed is not the same as searching and finding nothing,
       so it does not claim "0 kết quả" and no query runs. *@
    <div class="empty-state">
        <h1 class="empty-state__title">TÌM KIẾM</h1>
        <p class="empty-state__subtext">Nhập từ khóa để tìm sản phẩm bạn cần.</p>
        <img class="empty-state__illustration" src="~/images/search/no-results.svg"
             width="197" height="191" alt="" />
    </div>
}
else if (Model.TotalResultCount == 0)
{
    @* Node 1028:12593. The heading is this page's h1 in the empty state — the "kết quả tìm kiếm
       cho…" one above only renders when there is something to show. *@
    <div class="empty-state">
        @* No count line here: the header above already prints "0 kết quả" (node 988:23680), and
           Figma shows it once. *@
        <h1 class="empty-state__title">KHÔNG CÓ KẾT QUẢ</h1>
        <p class="empty-state__subtext">Vui lòng thử lại từ khóa khác hoặc quay lại <a href="/">trang chủ</a></p>
        <img class="empty-state__illustration" src="~/images/search/no-results.svg"
             width="197" height="191" alt="" />
    </div>
}
else
{
    @foreach (var group in Model.Groups)
    {
        <section class="search-group @(group.IsFallback ? "search-group--fallback" : "")">
            <div class="search-group__header">
                <h2 class="search-group__title">@group.CategoryName</h2>
                <span class="search-group__count">@group.TotalCount sản phẩm</span>
            </div>
            <div class="search-group__grid">
                @foreach (var product in group.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
            @if (group.TotalCount > group.Products.Count)
            {
                <div class="search-group__more">
                    <a href="@group.ShowMoreUrl">Xem thêm</a>
                </div>
            }
        </section>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}
