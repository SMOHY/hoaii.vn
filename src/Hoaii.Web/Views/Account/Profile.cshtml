@model Hoaii.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản";
    Layout = "_AccountLayout";
}

<div class="account-layout">
    <partial name="_AccountSidebar" model="@("Profile")" />

    <div class="account-content">
        <h1 class="account-content__heading">Thông tin cá nhân</h1>

        <div class="profile-card">
            <div class="profile-row">
                <span class="profile-row__label">Họ và tên</span>
                <div class="profile-row__value-group">
                    <span class="profile-row__value">@Model.FullNameOrPlaceholder</span>
                    <button type="button" class="profile-row__edit-btn" data-modal-open="edit-fullname-modal" aria-label="Chỉnh sửa họ và tên">
                        <svg class="profile-row__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                </div>
            </div>
            <div class="profile-row">
                <span class="profile-row__label">Giới tính</span>
                <div class="profile-row__value-group">
                    <span class="profile-row__value">@Model.GenderDisplay</span>
                    <button type="button" class="profile-row__edit-btn" data-modal-open="edit-gender-modal" aria-label="Chỉnh sửa giới tính">
                        <svg class="profile-row__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                </div>
            </div>
            <div class="profile-row">
                <span class="profile-row__label">Ngày sinh</span>
                <div class="profile-row__value-group">
                    <span class="profile-row__value">@Model.DateOfBirthDisplay</span>
                    <button type="button" class="profile-row__edit-btn" data-modal-open="edit-dob-modal" aria-label="Chỉnh sửa ngày sinh">
                        <svg class="profile-row__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                </div>
            </div>
            <div class="profile-row">
                <span class="profile-row__label">Email</span>
                <div class="profile-row__value-group">
                    <span class="profile-row__value">@Model.Email</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------- Edit modals (shared shell, see design-specs/account/profile-and-modals.md) ---------- *@
<div class="modal-backdrop" data-edit-modal-backdrop></div>

<div class="edit-modal" id="edit-fullname-modal" data-edit-modal aria-hidden="true">
    <div class="edit-modal__panel">
        <div class="edit-modal__header">
            <button type="button" class="edit-modal__close" data-modal-close aria-label="Đóng">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <span class="edit-modal__title">Họ và tên</span>
            <span class="edit-modal__spacer"></span>
        </div>
        <form method="post" asp-action="UpdateFullName" class="edit-modal__body">
            @Html.AntiForgeryToken()
            <div class="field-input">
                <label class="field-input__label">Họ và tên</label>
                <input type="text" name="value" class="field-input__value" value="@Model.FullNameValue" />
            </div>
            <div class="edit-modal__actions">
                <button type="button" class="edit-modal__btn edit-modal__btn--cancel" data-modal-close>Hủy</button>
                <button type="submit" class="edit-modal__btn edit-modal__btn--save">Lưu</button>
            </div>
        </form>
    </div>
</div>

<div class="edit-modal" id="edit-gender-modal" data-edit-modal aria-hidden="true">
    <div class="edit-modal__panel">
        <div class="edit-modal__header">
            <button type="button" class="edit-modal__close" data-modal-close aria-label="Đóng">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <span class="edit-modal__title">Giới tính</span>
            <span class="edit-modal__spacer"></span>
        </div>
        <form method="post" asp-action="UpdateGender" class="edit-modal__body">
            @Html.AntiForgeryToken()
            <div class="radio-group">
                <label class="radio-option">
                    <input type="radio" name="value" value="Male" checked="@(Model.GenderValue == "Male" ? "checked" : null)" />
                    <span class="radio-control"></span>
                    <span class="radio-option__label">Nam</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="value" value="Female" checked="@(Model.GenderValue == "Female" ? "checked" : null)" />
                    <span class="radio-control"></span>
                    <span class="radio-option__label">Nữ</span>
                </label>
            </div>
            <div class="edit-modal__actions">
                <button type="button" class="edit-modal__btn edit-modal__btn--cancel" data-modal-close>Hủy</button>
                <button type="submit" class="edit-modal__btn edit-modal__btn--save">Lưu</button>
            </div>
        </form>
    </div>
</div>

<div class="edit-modal" id="edit-dob-modal" data-edit-modal aria-hidden="true">
    <div class="edit-modal__panel">
        <div class="edit-modal__header">
            <button type="button" class="edit-modal__close" data-modal-close aria-label="Đóng">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <span class="edit-modal__title">Ngày sinh</span>
            <span class="edit-modal__spacer"></span>
        </div>
        <form method="post" asp-action="UpdateDateOfBirth" class="edit-modal__body">
            @Html.AntiForgeryToken()
            <div class="date-input">
                <input type="text" name="value" class="date-input__text" placeholder="DD/MM/YYYY" value="@Model.DateOfBirthValue" pattern="\d{2}/\d{2}/\d{4}" />
                <svg class="date-input__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 9h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <div class="edit-modal__actions">
                <button type="button" class="edit-modal__btn edit-modal__btn--cancel" data-modal-close>Hủy</button>
                <button type="submit" class="edit-modal__btn edit-modal__btn--save">Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/account.js" asp-append-version="true"></script>
}
