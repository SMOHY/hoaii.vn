@model Hoaii.Web.Models.Account.OrderHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="account-layout">
    <partial name="_AccountSidebar" model="@("Orders")" />

    <div class="account-content">
        <form method="get" asp-action="Orders" class="order-search">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2"/></svg>
            <input type="text" name="q" value="@Model.SearchTerm" placeholder="Tìm theo mã đơn hàng hoặc tên sản phẩm" />
            <input type="hidden" name="status" value="@Model.ActiveStatus" />
        </form>

        <div class="status-tabs">
            @foreach (var tab in Model.Tabs)
            {
                <a class="tab @(tab.Key == Model.ActiveStatus ? "active" : "")" href="?status=@tab.Key">@tab.Label</a>
            }
        </div>

        @if (Model.Orders.Count == 0)
        {
            <partial name="_OrdersEmptyState" />
        }
        else
        {
            <div class="order-list">
                @foreach (var order in Model.Orders)
                {
                    <partial name="_OrderCard" model="order" />
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}
