@model Hoaii.Web.Models.Product.ProductDetailsViewModel
@using Hoaii.Web.Services
@using Microsoft.AspNetCore.Html
@using System.Text.Json
@inject PageContentService PageC
@{
    var resolvedDescription = Model.MetaDescription ?? $"{Model.Name} — quà tặng thủ công tinh tế từ HOÀI.";
    ViewData["Title"] = Model.Name;
    ViewData["MetaDescription"] = resolvedDescription;
    ViewData["OgType"] = "product";
    ViewData["OgImage"] = Model.GalleryImages.FirstOrDefault();
    // Main gallery shot is a CSS background — name it so it starts downloading immediately.
    ViewData["PreloadImage"] = Model.GalleryImages.FirstOrDefault();

    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var breadcrumbParts = Model.BreadcrumbLabel.Split('/');
    var productJsonLd = new
    {
        context = "https://schema.org",
        type = "Product",
        name = Model.Name,
        image = Model.GalleryImages.Where(i => i is not null).Select(i => origin + i).ToList(),
        description = resolvedDescription,
        offers = new
        {
            type = "Offer",
            priceCurrency = "VND",
            price = Model.Price,
            availability = "https://schema.org/InStock",
            url = origin + Context.Request.Path,
        },
    };
    var breadcrumbJsonLd = new
    {
        context = "https://schema.org",
        type = "BreadcrumbList",
        itemListElement = new object[]
        {
            new { type = "ListItem", position = 1, name = "Trang chủ", item = origin + "/" },
            new { type = "ListItem", position = 2, name = breadcrumbParts.ElementAtOrDefault(1) ?? breadcrumbParts[0], item = origin + "/danh-muc/" + Model.CategorySlug },
            new { type = "ListItem", position = 3, name = Model.Name, item = origin + Context.Request.Path },
        },
    };
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    string ToLd(object o) => JsonSerializer.Serialize(o, jsonOptions)
        .Replace("\"context\"", "\"@context\"").Replace("\"type\"", "\"@type\"");
    ViewData["StructuredData"] = new HtmlString(
        $"<script type=\"application/ld+json\">{ToLd(productJsonLd)}</script>" +
        $"<script type=\"application/ld+json\">{ToLd(breadcrumbJsonLd)}</script>");
}

<div class="pdp-breadcrumb">
    @{
        var parts = Model.BreadcrumbLabel.Split('/');
    }
    <span>@parts[0]/</span><span class="pdp-breadcrumb__current">@(parts.Length > 1 ? parts[1] : "")</span>
</div>

<section class="pdp-main">
    <div class="pdp-gallery">
        <div class="pdp-gallery__main" id="pdp-main-image" style="@(Model.GalleryImages.Count > 0 ? $"background-image:url('{Model.GalleryImages[0]}')" : "")"></div>
        @* Only show the thumb strip / dots when there is more than one shot. *@
        @if (Model.GalleryImages.Count > 1)
        {
            <div class="pdp-gallery__thumbs">
                @for (var i = 0; i < Model.GalleryImages.Count; i++)
                {
                    <button type="button" class="pdp-gallery__thumb @(i == 0 ? "active" : "")" data-image="@Model.GalleryImages[i]"
                            style="background-image:url('@Model.GalleryImages[i]')" aria-label="Ảnh @(i + 1)"></button>
                }
            </div>
            <div class="pdp-dots">
                @for (var i = 0; i < Model.GalleryImages.Count; i++)
                {
                    <span class="pdp-dot @(i == 0 ? "active" : "")" data-dot-index="@i"></span>
                }
            </div>
        }
    </div>

    <div class="pdp-info">
        <div class="pdp-title-block">
            <h1 class="pdp-title">@Model.Name.ToUpperInvariant()</h1>
            @* Khởi tạo theo giá của hộp đầu tiên (hộp được chọn mặc định), không phải giá gốc
               thuần — nếu biến thể đầu có giá chênh thì lúc tải trang giá đã đúng ngay. *@
            <p class="pdp-price">@((Model.BoxOptions.Count > 0 ? Model.BoxOptions[0].Price : Model.Price).ToString("N0")) VNĐ</p>
            <p class="pdp-price-note">@PageC.Get(PageContentKeys.Shop, "pdp_price_note")</p>
        </div>

        @* Figma keeps a colour picker in the file but ships it hidden (node 826:20630),
           so the only variant axis on the page is the box size. *@

        @if (Model.BoxOptions.Count > 0)
        {
            <div class="pdp-option-group">
                <span class="pdp-option-label">LOẠI HỘP</span>
                <div class="pdp-box-options">
                    @for (var i = 0; i < Model.BoxOptions.Count; i++)
                    {
                        var b = Model.BoxOptions[i];
                        @* data-price mang chuỗi giá đã format sẵn (giữ định dạng VN "395.000"),
                           để pdp.js chỉ việc thay text, không format lại ở client. *@
                        <button type="button" class="pdp-box-option @(i == 0 ? "selected" : "")" data-box-id="@b.Id" data-price="@($"{b.Price:N0} VNĐ")">@b.Label</button>
                    }
                </div>
            </div>
        }

        <div class="pdp-qty-share-row">
            <div class="pdp-qty-stepper">
                <button type="button" class="pdp-qty-stepper__btn" data-qty-decrease aria-label="Giảm số lượng">−</button>
                <span class="pdp-qty-stepper__value" id="pdp-qty-value">1</span>
                <button type="button" class="pdp-qty-stepper__btn" data-qty-increase aria-label="Tăng số lượng">+</button>
            </div>
            <button type="button" class="pdp-share-btn" aria-label="Chia sẻ">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M8.6 10.5l6.8-3.7M8.6 13.5l6.8 3.7" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
        </div>

        <div class="pdp-cta-group">
            <form method="post" action="/gio-hang/them" id="pdp-add-to-cart-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <input type="hidden" name="variantId" id="pdp-variant-id-input" value="@(Model.BoxOptions.Count > 0 ? Model.BoxOptions[0].Id.ToString() : "")" />
                <input type="hidden" name="quantity" id="pdp-qty-input" value="1" />
                <input type="hidden" name="returnUrl" value="/san-pham/@Model.Slug" />
                <button type="submit" class="pdp-cta-primary">THÊM VÀO GIỎ HÀNG</button>
            </form>
            <button type="button" class="pdp-cta-secondary" data-contact-popup-open>NHẬN ƯU ĐÃI MUA SỐ LƯỢNG LỚN</button>
        </div>

        @* Ẩn cả khối khi chưa có thành phần: một tiêu đề "THÀNH PHẦN" đứng trơ với dòng "sẽ được
           cập nhật" nói thẳng với khách rằng trang chưa xong. Figma gõ nhầm "THÀN PHẦN"
           (node 826:13863); web giữ đúng chính tả. *@
        @if (Model.Ingredients is { Length: > 0 })
        {
            <div class="pdp-ingredients">
                <p class="pdp-ingredients__label">THÀNH PHẦN :</p>
                <p class="pdp-ingredients__body">@Model.Ingredients</p>
            </div>
        }
    </div>
</section>

<section class="pdp-story">
    <div class="pdp-story__container">
        <div class="pdp-story__row1">
            <div class="pdp-story__image" style="@(Model.StoryImageUrl is not null ? $"background-image:url('{Model.StoryImageUrl}')" : "")"></div>
            <div class="pdp-story__text">
                <h2>@Model.StoryTitle</h2>
                <p>@Model.StoryBody</p>
                @* Folk-art motif strip under the story copy (node 1028:15089). *@
                <img class="pdp-story__motif" src="~/images/pdp/pattern.png" alt="" loading="lazy" />
            </div>
        </div>
        @{
            // Figma renders the first line as a lead-in and the dimensions under it as a
            // bulleted list (node 826:13881).
            var featureLines = Model.FeatureBody.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        }
        @* The whole row goes when there are no measurements — an "Đặc điểm" heading over nothing
           reads as a loading failure. *@
        @if (featureLines.Length > 0)
        {
            <div class="pdp-story__row2">
                <div class="text">
                    <h2>@Model.FeatureTitle</h2>
                    <div class="pdp-feature-body">
                        <p>@featureLines[0]</p>
                        @if (featureLines.Length > 1)
                        {
                            <ul>
                                @foreach (var line in featureLines.Skip(1))
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="image" style="@(Model.FeatureImageUrl is not null ? $"background-image:url('{Model.FeatureImageUrl}')" : "")"></div>
            </div>
        }
    </div>
</section>

@if (Model.Collection is not null)
{
    <section class="pdp-collection">
        <div class="pdp-collection__header">
            <p class="pdp-collection__eyebrow">@Model.Collection.Eyebrow</p>
            <h2 class="pdp-collection__title">@Model.Collection.Title</h2>
        </div>
        <div class="pdp-collection__grid">
            @foreach (var item in Model.Collection.Items)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

@if (Model.RelatedProducts.Count > 0)
{
    <section class="pdp-related">
        <h2 class="pdp-related__title">@PageC.Get(PageContentKeys.Shop, "pdp_related_heading")</h2>
        <div class="pdp-related__grid">
            @foreach (var item in Model.RelatedProducts)
            {
                <partial name="_ProductCard" model="item" />
            }
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdp.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/pdp.js" asp-append-version="true"></script>
}
