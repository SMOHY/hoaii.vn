@model IReadOnlyList<Hoaii.Web.Models.Home.BlogPostViewModel>
@using Hoaii.Web.Services
@inject PageContentService Page
@* Blog (HOÀI MÁCH BẠN) — see design-specs/home/04-blog-and-story.md *@
@{
    var featured = Model.FirstOrDefault(p => p.IsFeatured) ?? Model[0];
    var rest = Model.Where(p => p != featured).ToList();
}
<section class="blog-section">
    @* Desktop node 1214:38914 vs mobile node 1062:12758 — different headings. *@
    <h2 class="blog-heading">
        <span class="u-desktop-only">@Page.Get(PageContentKeys.Home, "blog_heading_desktop")</span>
        <span class="u-mobile-only">@Page.Get(PageContentKeys.Home, "blog_heading_mobile")</span>
    </h2>

    <div class="blog-cards blog-cards--desktop">
        <div class="blog-featured">
            <div class="blog-featured__img" style="background-image:url('@featured.ImageUrl')"></div>
            <div class="blog-featured__text">
                <div class="blog-card__meta">
                    <span class="blog-card__category">@featured.Category</span>
                    <span class="blog-card__title">@featured.Title</span>
                </div>
                <p class="blog-card__excerpt">@featured.Excerpt</p>
            </div>
        </div>
        <div class="blog-list">
            @foreach (var post in rest)
            {
                @* Copy stacked in one column, thumbnail beside it — not three columns, which
                   squeezed the headline onto three lines (node 1214:38925). *@
                <a class="blog-list__row" href="@post.Url">
                    <div class="blog-list__text">
                        <div class="blog-card__meta">
                            <span class="blog-card__category">@post.Category</span>
                            <span class="blog-card__title">@post.Title</span>
                        </div>
                        <p class="blog-card__excerpt">@post.Excerpt</p>
                    </div>
                    <div class="blog-list__thumb" style="background-image:url('@post.ImageUrl')"></div>
                </a>
            }
        </div>
    </div>

    <div class="blog-cards blog-cards--mobile">
        @foreach (var post in Model)
        {
            <a class="blog-list__row" href="@post.Url">
                <div class="blog-list__thumb" style="background-image:url('@post.ImageUrl')"></div>
                <div class="blog-card__meta">
                    <span class="blog-card__category">@post.Category</span>
                    <span class="blog-card__title">@post.Title</span>
                </div>
            </a>
        }
    </div>
</section>
