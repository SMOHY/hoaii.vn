@* Hero — see design-specs/home/01-hero-and-benefits.md *@
<section class="home-hero">
    <div class="home-hero__stage">
        <button class="home-hero__arrow home-hero__arrow--prev" type="button" aria-label="Slide trước">
            <svg width="20" height="10" viewBox="0 0 20 10" fill="none" aria-hidden="true"><path d="M1 5h18M1 5l5-4M1 5l5 4" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <button class="home-hero__arrow home-hero__arrow--next" type="button" aria-label="Slide tiếp theo">
            <svg width="20" height="10" viewBox="0 0 20 10" fill="none" aria-hidden="true"><path d="M1 5h18M19 5l-5-4M19 5l-5 4" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
    </div>

    <div class="home-hero__content">
        <div class="home-hero__dots" aria-hidden="true">
            <span class="dot dot--active"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
        @* Figma ships different hero copy per breakpoint:
           desktop node 1214:38726, mobile node 1062:12563. *@
        <h1 class="home-hero__title">
            <span class="u-desktop-only">TINH HOA VIỆT NAM</span>
            <span class="u-mobile-only">VIỆT NAM HOA THỊ</span>
        </h1>
        <p class="home-hero__subtitle">
            <span class="u-desktop-only">Bộ sưu tập Quà tặng Trung Thu 2026</span>
            <span class="u-mobile-only">Concept tết mới nhất 2026</span>
        </p>
    </div>
</section>
