@model IReadOnlyList<Hoaii.Web.Models.Home.FeaturedTileViewModel>
@* Danh sách sản phẩm đặc biệt — see design-specs/home/02-featured-products.md *@
<section class="featured-section">
    <div class="featured-heading">
        <h2 class="featured-title">LỰA CHỌN HÀNG ĐẦU</h2>
        <p class="featured-subtitle">Mỗi sản phẩm quà tặng trong bộ sưu tập của chúng tôi được chế tác công phu, tôn vinh từng chi tiết tinh xảo và lấy cảm hứng từ sự đa dạng của các truyền thống văn hóa.</p>
    </div>

    <div class="featured-grid">
        @foreach (var tile in Model)
        {
            @if (tile.IsCard)
            {
                @* Figma uses different copy per breakpoint: "Phẩm quà"/"Khám phá" on desktop,
                   "Bộ sưu tập"/"Xem thêm" on mobile. Render both, toggle with CSS. *@
                <a class="featured-card featured-card--@tile.AccentColor" href="@tile.LinkUrl">
                    <div class="featured-card__top">
                        <span class="featured-card__eyebrow">
                            <span class="u-desktop-only">Phẩm quà</span>
                            <span class="u-mobile-only">Bộ sưu tập</span>
                        </span>
                        <span class="featured-card__title">
                            <span>@tile.TitleLine1</span>
                            <span>@tile.TitleLine2</span>
                        </span>
                        @if (!string.IsNullOrEmpty(tile.EditionLabel))
                        {
                            <span class="featured-card__edition u-desktop-only">@tile.EditionLabel</span>
                        }
                    </div>
                    <div class="featured-card__cta">
                        <span class="featured-card__cta-label">
                            <span class="u-desktop-only">Khám phá</span>
                            <span class="u-mobile-only">Xem thêm</span>
                        </span>
                        <svg class="featured-card__cta-icon" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true"><path d="M2 8.5h13M9 3l6 5.5-6 5.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    </div>
                </a>
            }
            else
            {
                <a class="featured-tile @(tile.HideOnMobile ? "featured-tile--desktop-only" : "")"
                   style="background-image:url('@tile.ImageUrl')" href="#" aria-label="Sản phẩm"></a>
            }
        }
    </div>
</section>
