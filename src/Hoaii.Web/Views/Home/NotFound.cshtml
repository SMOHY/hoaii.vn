@{
    ViewData["Title"] = "Không tìm thấy trang";
    ViewData["NoIndex"] = true;
}

<div style="max-width:640px; margin:0 auto; padding:120px 24px; text-align:center;">
    <p style="font:600 20px/1 var(--font-body); color:var(--color-brand-gold); margin:0 0 16px;">404</p>
    <h1 style="font-family:var(--font-display); font-size:32px; margin:0 0 16px;">Không tìm thấy trang bạn cần</h1>
    <p style="color:var(--color-grey-500); font:500 16px/24px var(--font-body); margin:0 0 32px;">
        Trang này có thể đã bị xóa, đổi địa chỉ, hoặc chưa từng tồn tại.
    </p>
    <a href="/" class="btn btn--primary" style="display:inline-block; padding:14px 32px; border-radius:8px; background:var(--color-brand-gold); color:#fff; text-decoration:none; font:600 16px/1 var(--font-body);">
        Về trang chủ
    </a>
</div>
