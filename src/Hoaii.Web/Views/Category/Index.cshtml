@model Hoaii.Web.Models.Category.CategoryPageViewModel
@using Hoaii.Web.Services
@using Microsoft.AspNetCore.Html
@using System.Text.Json
@inject PageContentService PageC
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = Model.Description;
    ViewData["HeroOverlay"] = true;
    ViewData["PreloadImage"] = Model.BannerImageUrl ?? Model.HeroSlides.FirstOrDefault()?.ImageUrl;
    var hasSlides = Model.HeroSlides.Count > 0;

    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var breadcrumbJsonLd = new
    {
        context = "https://schema.org",
        type = "BreadcrumbList",
        itemListElement = new object[]
        {
            new { type = "ListItem", position = 1, name = "Trang chủ", item = origin + "/" },
            new { type = "ListItem", position = 2, name = Model.Title, item = origin + Context.Request.Path },
        },
    };
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var breadcrumbJson = JsonSerializer.Serialize(breadcrumbJsonLd, jsonOptions)
        .Replace("\"context\"", "\"@context\"").Replace("\"type\"", "\"@type\"");
    ViewData["StructuredData"] = new HtmlString($"<script type=\"application/ld+json\">{breadcrumbJson}</script>");
}

@if (Model.HeroStyle == Hoaii.Domain.Entities.CategoryHeroStyle.Banner)
{
    @* Eight of the ten listings open on a wide banner instead of the carousel: a 1440x600 block
       with the category name sitting near its bottom-left (node 1269:39703). Figma has not placed
       a photograph behind any of them, so a null image renders the flat block it draws. *@
    <section class="cat-banner">
        <div class="cat-banner__inner @(Model.BannerImageUrl is null ? "cat-banner__inner--empty" : "")">
            @if (Model.BannerImageUrl is not null)
            {
                <img src="@Model.BannerImageUrl" alt="@Model.Title" fetchpriority="high" />
            }
            <p class="cat-banner__title">@Model.Title.ToUpperInvariant()</p>
        </div>
    </section>
}
else
{
@* Red hero with a coverflow carousel of the category's products (node 1519:33993).
   With no products the carousel and its pager collapse, leaving a compact title band. *@
<section class="cat-hero @(hasSlides ? "" : "cat-hero--bare")" data-cat-carousel>
    <p class="cat-hero__eyebrow">@Model.HeroEyebrow</p>

    @if (hasSlides)
    {
        <div class="cat-hero__track" data-cat-track>
            @* Only the slide on screen is worth fetching up front; the rest wait until swiped to. *@
            @for (var i = 0; i < Model.HeroSlides.Count; i++)
            {
                var slide = Model.HeroSlides[i];
                <a class="cat-hero__slide" href="/san-pham/@slide.Slug" data-cat-slide data-name="@slide.Name">
                    <img src="@slide.ImageUrl" alt="@slide.Name"
                         loading="@(i == 0 ? "eager" : "lazy")"
                         fetchpriority="@(i == 0 ? "high" : "auto")" />
                </a>
            }
        </div>
    }

    <div class="cat-hero__caption">
        @if (hasSlides)
        {
            @* One row of three equal columns (node 1519:34009): the kicker centres in the
               middle one, the pager sits right, and the left column is an empty spacer —
               Figma ships it as a second pager at opacity 0. *@
            <div class="cat-hero__meta">
                <span class="cat-hero__meta-spacer" aria-hidden="true"></span>
                @* Per-category copy: Quà tết says "Bộ quà 6 hộp", Quà trung thu "Bộ quà 4 hộp
                   bánh" (nodes 1519:34009 and 758:11395). Blank leaves the middle column empty
                   rather than printing a box count nobody has confirmed. *@
                <p class="cat-hero__kicker">@Model.HeroKicker</p>
                <div class="cat-hero__pager">
                    <button type="button" class="cat-hero__arrow" data-cat-prev aria-label="Sản phẩm trước">
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 15l-5-5 5-5" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                    <span data-cat-counter>1/@Model.HeroSlides.Count</span>
                    <button type="button" class="cat-hero__arrow" data-cat-next aria-label="Sản phẩm sau">
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>
                    </button>
                </div>
            </div>
        }
        @* Not an <h1>: this caption swaps to whichever product the carousel is on, so it would make
           the page heading change as you click. The category heading below is the real h1. *@
        <p class="cat-hero__title" data-cat-title>@(Model.HeroSlides.FirstOrDefault()?.Name.ToUpperInvariant() ?? Model.Title.ToUpperInvariant())</p>
    </div>

    @if (hasSlides)
    {
        <p class="cat-hero__scroll-hint">Cuộn xuống để xem tất cả sản phẩm</p>
    }
</section>
}

<div class="container cat-content">
    @* Real breadcrumb rather than one "Trang chủ/Quà tết" string, so the first crumb is a link
       and assistive tech can announce the current page. *@
    <nav class="cat-breadcrumb" aria-label="Breadcrumb">
        <ol>
            <li><a href="/">Trang chủ</a></li>
            @* Occasion listings sit under a landing page, so Figma shows three levels
               (node 1269:39709). Categories without a parent keep two. *@
            @if (Model.Parent is not null)
            {
                <li><a href="@Model.Parent.Url">@Model.Parent.Label</a></li>
            }
            <li aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="filter-bar">
        <div class="filter-bar__heading">
            <h1 class="filter-bar__title">Tất cả @Model.Title.ToLowerInvariant()</h1>
            <p class="filter-bar__desc">@Model.Description</p>
        </div>
        @{
            var sortOptions = Hoaii.Web.Controllers.CategoryController.SortOptions;
            var activeSort = sortOptions.First(o => o.Key == Model.Sort);
            // Changing sort must not silently drop the filters the shopper already picked.
            string FilterUrl2(string sortKey) =>
                $"/danh-muc/{Model.Slug}?sort={sortKey}"
                + (Model.PriceFilter.Length > 0 ? $"&price={Model.PriceFilter}" : "")
                + (Model.InStockOnly ? "&inStock=true" : "");
        }
        @* Both controls were rendered but inert. They are plain links now, so sorting and
           filtering keep working with JS off; category.js only turns them into popovers. *@
        <div class="filter-bar__actions">
            <span class="filter-bar__sort-label">Sắp xếp theo</span>

            <div class="filter-menu" data-filter-menu>
                <button type="button" class="filter-bar__dropdown" data-filter-toggle aria-expanded="false" aria-haspopup="true" aria-controls="sort-panel">
                    <span>@activeSort.Label</span>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
                <ul class="filter-menu__panel" id="sort-panel" data-filter-panel>
                    @foreach (var option in sortOptions)
                    {
                        <li>
                            <a href="@FilterUrl2(option.Key)" class="@(option.Key == Model.Sort ? "is-active" : "")">@option.Label</a>
                        </li>
                    }
                </ul>
            </div>

            @* The panel used to just repeat the sort options, so "Bộ lọc" narrowed nothing.
               These are real filters: they go through the querystring and the controller
               applies them before counting and paging. *@
            @{
                var priceFilters = Hoaii.Web.Controllers.CategoryController.PriceFilters;
                string FilterUrl(string priceKey, bool stock) =>
                    $"/danh-muc/{Model.Slug}?sort={Model.Sort}"
                    + (priceKey.Length > 0 ? $"&price={priceKey}" : "")
                    + (stock ? "&inStock=true" : "");
            }
            <div class="filter-menu" data-filter-menu>
                <button type="button" class="filter-bar__filter-btn" data-filter-toggle aria-expanded="false" aria-haspopup="true" aria-controls="filter-panel">
                    <span>Bộ lọc@(Model.ActiveFilterCount > 0 ? $" ({Model.ActiveFilterCount})" : "")</span>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
                <ul class="filter-menu__panel filter-menu__panel--right" id="filter-panel" data-filter-panel>
                    <li class="filter-menu__group">Khoảng giá</li>
                    @foreach (var band in priceFilters)
                    {
                        var isOn = Model.PriceFilter == band.Key;
                        <li>
                            <a href="@FilterUrl(isOn ? "" : band.Key, Model.InStockOnly)"
                               class="@(isOn ? "is-active" : "")" aria-pressed="@(isOn ? "true" : "false")">@band.Label</a>
                        </li>
                    }
                    <li class="filter-menu__group">Tình trạng</li>
                    <li>
                        <a href="@FilterUrl(Model.PriceFilter, !Model.InStockOnly)"
                           class="@(Model.InStockOnly ? "is-active" : "")" aria-pressed="@(Model.InStockOnly ? "true" : "false")">Còn hàng</a>
                    </li>
                    @if (Model.ActiveFilterCount > 0)
                    {
                        <li><a href="/danh-muc/@Model.Slug?sort=@Model.Sort">Xóa bộ lọc</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @* Empty state — Figma node 1538:39514. *@
    @if (Model.Products.Count == 0)
    {
        <div class="cat-empty">
            <h2 class="cat-empty__title">@PageC.Get(PageContentKeys.Shop, "category_empty_title")</h2>
            <p class="cat-empty__text">@PageC.Get(PageContentKeys.Shop, "category_empty_text") <a href="/">trang chủ</a></p>
            <img class="cat-empty__art" src="~/images/empty-state.png" alt="" loading="lazy" />
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            @* Paging has to carry the sort through, or page 2 silently reverts to the default order. *@
            var atStart = Model.CurrentPage <= 1;
            var atEnd = Model.CurrentPage >= Model.TotalPages;
            <nav class="pagination" aria-label="Phân trang">
                <a class="pagination__arrow @(atStart ? "pagination__arrow--disabled" : "")"
                   href="?sort=@Model.Sort@(Model.PriceFilter.Length > 0 ? $"&price={Model.PriceFilter}" : "")@(Model.InStockOnly ? "&inStock=true" : "")&page=@(Model.CurrentPage - 1)" aria-label="Trang trước"
                   aria-disabled="@(atStart ? "true" : "false")" tabindex="@(atStart ? "-1" : "0")">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 15l-5-5 5-5" stroke="currentColor" stroke-width="1.5"/></svg>
                </a>
                <span class="pagination__label">@Model.CurrentPage/@Model.TotalPages</span>
                <a class="pagination__arrow @(atEnd ? "pagination__arrow--disabled" : "")"
                   href="?sort=@Model.Sort@(Model.PriceFilter.Length > 0 ? $"&price={Model.PriceFilter}" : "")@(Model.InStockOnly ? "&inStock=true" : "")&page=@(Model.CurrentPage + 1)" aria-label="Trang sau"
                   aria-disabled="@(atEnd ? "true" : "false")" tabindex="@(atEnd ? "-1" : "0")">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>
                </a>
            </nav>
        }
    }
</div>

@* Artist collaboration banner (node 1519:34045). Figma draws two widths and a different
   background per category, both of which live on the Category row rather than in CSS.
   The colour is emitted as a custom property so the stylesheet still owns every other rule. *@
<section class="promo-banner @(Model.Promo.Wide ? "promo-banner--wide" : "")"
         style="@(Model.Promo.Background is { Length: > 0 } bg ? $"--promo-bg:{bg}" : "")">
    <div class="promo-banner__text">
        <p class="promo-banner__eyebrow">@Model.Promo.Eyebrow</p>
        <p class="promo-banner__title">@Model.Promo.Title</p>
        <a href="@Model.Promo.CtaUrl" class="promo-banner__cta">@Model.Promo.CtaText</a>
    </div>
    @if (Model.Promo.ImageUrl is not null)
    {
        <div class="promo-banner__image">
            <img src="@Model.Promo.ImageUrl" alt="@Model.Promo.Eyebrow" loading="lazy" />
        </div>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/category.js" asp-append-version="true"></script>
}
